---
/* Full-screen canvas behind the homepage: dust, a paper crane, then a short story of shapes.
   The loop lives here; the Gate and the page chrome subscribe to it through lib/gate/state. */
---

<div class="bg-wash" aria-hidden="true"></div>
<canvas id="bg" aria-hidden="true"></canvas>
<div class="bg-scrim" aria-hidden="true"></div>

<style>
  .bg-wash, #bg, .bg-scrim { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .bg-wash { z-index: 0; background: radial-gradient(120% 90% at 72% 8%, #17160e 0%, var(--color-canvas) 62%); }
  #bg { z-index: 1; display: block; }
  /* keeps the lede readable where points drift behind it */
  .bg-scrim { z-index: 2; background: radial-gradient(60% 50% at 24% 92%, rgba(13, 13, 9, 0.82), rgba(13, 13, 9, 0) 72%); }
</style>

<script>
  import { Scene } from '../lib/gate/scene.ts';
  import { autoProgress, clamp, scrollProgress } from '../lib/gate/math.ts';
  import { emitFrame, gate, gateSeen, openGate, reduceMotion } from '../lib/gate/state.ts';

  const canvas = document.getElementById('bg') as HTMLCanvasElement;
  const caption = document.getElementById('story-line');
  const ticks = document.querySelectorAll<HTMLElement>('.story-tick');

  const reduce = reduceMotion();
  /* reduced motion and repeat visits in the same session go straight to the page */
  if (reduce || gateSeen()) { openGate(); gate.p = 1; }

  const scene = new Scene({
    canvas, reduce,
    onChapter(text, tick) {
      if (caption) caption.textContent = text;
      ticks.forEach((el, j) => el.classList.toggle('on', j === tick));
    },
  });

  let T = 0, last = performance.now(), fade = 0, raf = 0, onscreen = true;

  function loop(now: number) {
    raf = 0;
    const raw = clamp((now - last) / 1000, 0, 0.05); last = now;
    T += reduce ? raw * 0.2 : raw; /* reduced motion: everything moves at a fifth of the speed */
    fade = Math.min(1, fade + raw * 1.3);

    /* scroll drives the gate; if nobody scrolls it eases open on its own. Progress only ever goes forward. */
    if (gate.target < 1) gate.idle += raw;
    gate.target = Math.max(gate.target, scrollProgress(window.scrollY, window.innerHeight), autoProgress(gate.idle));
    gate.p += (gate.target - gate.p) * Math.min(1, raw * 5);
    if (gate.target >= 1 && gate.p > 0.9995) gate.p = 1;

    scene.frame(T, gate.p, fade, raw);
    emitFrame(raw);
    schedule();
  }

  /* run only while the tab is visible and the canvas is on screen */
  function schedule() {
    if (!raf && !document.hidden && onscreen) raf = requestAnimationFrame(loop);
  }
  function halt() { if (raf) cancelAnimationFrame(raf); raf = 0; }
  function resume() { last = performance.now(); schedule(); }

  document.addEventListener('visibilitychange', () => (document.hidden ? halt() : resume()));
  new IntersectionObserver(([entry]) => { onscreen = entry.isIntersecting; onscreen ? resume() : halt(); }).observe(canvas);

  window.addEventListener('resize', () => scene.resize());
  for (const type of ['pointermove', 'pointerdown', 'pointerup', 'pointercancel'] as const) {
    window.addEventListener(type, (e) => {
      /* presses on links and buttons are navigation, not "next shape" */
      if (type === 'pointerup' && (e.target as Element | null)?.closest?.('a, button')) return;
      scene.pointer(e);
    }, { passive: true });
  }

  /* the canvas reads Raleway for its numbers: ask for it before first use */
  document.fonts?.load('300 12px "Raleway Variable"');

  schedule();
</script>
