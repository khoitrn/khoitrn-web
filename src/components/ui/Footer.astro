---
const year = new Date().getFullYear();
const links = [
  { href: 'https://github.com/khoitrn',         label: 'GitHub' },
  { href: 'https://linkedin.com/in/khoitrn',    label: 'LinkedIn' },
  { href: 'https://x.com/khoitrn',              label: 'X' },
  { href: 'mailto:khoi@tamu.edu',               label: 'Email' },
];
---

<footer style="margin-top: 0; padding-top: 1rem;">
  <div style="max-width: 1100px; margin: 0 auto; padding: 3rem clamp(1.25rem, 4vw, 3rem);">
    <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 1rem; flex-wrap: wrap; gap: 1.25rem;">
      <p class="font-[family-name:var(--font-ui)] text-sm lowercase tracking-[0.02em] text-[var(--color-muted)]">
        © {year} Khoi Tran
      </p>
      <ul style="display: flex; flex-wrap: wrap; gap: 0.25rem 2rem; list-style: none;">
        {links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              target={href.startsWith('http') ? '_blank' : undefined}
              rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="font-[family-name:var(--font-ui)] text-sm lowercase tracking-[0.02em] text-[var(--color-muted)] hover:text-[var(--color-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)] transition-colors duration-500 inline-block py-2"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
