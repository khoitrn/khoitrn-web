---
const year = new Date().getFullYear();
const links = [
  { href: 'https://github.com/khoitrn',      label: 'github' },
  { href: 'https://linkedin.com/in/khoitrn', label: 'linkedin' },
  { href: 'https://x.com/khoitrn',           label: 'x' },
  { href: 'mailto:khoi@tamu.edu',            label: 'email' },
];
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <p>© {year} khoi tran</p>
    <ul>
      {links.map(({ href, label }) => (
        <li>
          <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}>{label}</a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer-inner {
    max-width: 1184px; margin: 0 auto; padding: 2.5rem clamp(1.25rem, 4vw, 3rem);
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 1.5rem;
  }
  p, a { font-family: var(--font-display); font-weight: 300; font-size: 0.875rem; letter-spacing: 0.04em; color: var(--color-muted); text-transform: lowercase; }
  ul { display: flex; flex-wrap: wrap; gap: 0 2rem; list-style: none; }
  a { display: inline-block; padding: 0.5rem 0; text-decoration: none; transition: color 0.3s; }
  a:hover { color: var(--color-accent); }
  a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; border-radius: 2px; }
</style>
