---
/* One-click listening. Any button with data-listen starts a talk in a docked player that stays at the
   bottom of the screen while the visitor keeps browsing the page.
   - data-audio set: a real audio-only bar (a file uploaded in Studio).
   - otherwise data-yt: a small docked YouTube player. The video stays visible, as YouTube requires. */
---

<div id="listen-dock" class="dock" hidden role="region" aria-label="Now listening">
  <div class="dock-video" id="dock-video" hidden></div>
  <div class="dock-main">
    <p class="dock-label">now listening</p>
    <p class="dock-title" id="dock-title"></p>
    <div class="dock-audio" id="dock-audio" hidden>
      <button type="button" class="dock-toggle" id="dock-toggle" aria-label="Pause">pause</button>
      <input type="range" id="dock-seek" min="0" max="1000" value="0" step="1" aria-label="Seek" />
      <span class="dock-time" id="dock-time">0:00</span>
    </div>
  </div>
  <button type="button" class="dock-close" id="dock-close" aria-label="Close player">close</button>
</div>
<audio id="dock-el" preload="none"></audio>

<style>
  .dock {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 150;
    display: flex; align-items: center; gap: 1.25rem;
    padding: 0.9rem max(1.25rem, env(safe-area-inset-right, 0px)) calc(0.9rem + env(safe-area-inset-bottom, 0px)) max(1.25rem, env(safe-area-inset-left, 0px));
    background: rgba(20, 20, 16, 0.96); border-top: 1px solid var(--color-rule-soft);
    backdrop-filter: blur(8px);
  }
  .dock[hidden] { display: none; }
  .dock-video { flex: none; width: 256px; max-width: 42vw; aspect-ratio: 16 / 9; background: #000; position: relative; border-radius: 2px; overflow: hidden; }
  .dock-main { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 0.35rem; text-transform: lowercase; }
  .dock-label { font-family: var(--font-display); font-weight: 300; font-size: 0.75rem; letter-spacing: 0.08em; color: var(--color-accent); }
  .dock-title { font-family: var(--font-display); font-weight: 300; font-size: 1.0625rem; line-height: 1.3; color: var(--color-ink); overflow-wrap: anywhere; }
  .dock-audio { display: flex; align-items: center; gap: 0.9rem; margin-top: 0.25rem; }
  .dock-toggle, .dock-close {
    flex: none; min-height: 44px; padding: 0 1rem; background: none; cursor: pointer;
    border: 1px solid var(--color-rule); color: var(--color-accent); border-radius: 999px;
    font-family: var(--font-display); font-weight: 300; font-size: 0.8125rem; letter-spacing: 0.04em; text-transform: lowercase;
    transition: background 0.25s, color 0.25s;
  }
  .dock-toggle:hover, .dock-close:hover { background: var(--color-accent); color: var(--color-canvas); }
  .dock-close { border-color: var(--color-border); color: var(--color-muted); }
  #dock-seek { flex: 1 1 auto; min-width: 0; accent-color: var(--color-accent); height: 44px; }
  .dock-time { flex: none; font-family: var(--font-display); font-weight: 300; font-size: 0.8125rem; color: var(--color-muted); font-variant-numeric: tabular-nums; min-width: 3ch; }
  .dock :focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }

  @media (max-width: 560px) {
    .dock { gap: 0.9rem; padding-top: 0.8rem; }
    .dock-video { width: 8.5rem; max-width: none; }
    .dock-title { font-size: 1rem; }
    .dock-close { position: absolute; top: 0.35rem; right: max(0.6rem, env(safe-area-inset-right, 0px)); min-height: 36px; padding: 0 0.8rem; }
  }
</style>

<script>
  const dock = document.getElementById('listen-dock')!;
  const video = document.getElementById('dock-video')!;
  const titleEl = document.getElementById('dock-title')!;
  const audioUi = document.getElementById('dock-audio')!;
  const toggle = document.getElementById('dock-toggle')!;
  const seek = document.getElementById('dock-seek') as HTMLInputElement;
  const timeEl = document.getElementById('dock-time')!;
  const audio = document.getElementById('dock-el') as HTMLAudioElement;
  let active: HTMLElement | null = null;

  const fmt = (s: number) => (isFinite(s) ? `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}` : '0:00');

  function stop() {
    audio.pause();
    audio.removeAttribute('src');
    audio.load();
    video.innerHTML = '';
    video.hidden = true;
    audioUi.hidden = true;
    active?.setAttribute('aria-pressed', 'false');
    active = null;
  }

  function start(btn: HTMLElement) {
    stop();
    active = btn;
    btn.setAttribute('aria-pressed', 'true');
    titleEl.textContent = btn.dataset.title ?? '';
    dock.hidden = false;
    document.body.style.paddingBottom = '10rem';

    if (btn.dataset.audio) {
      audioUi.hidden = false;
      audio.src = btn.dataset.audio;
      audio.play().catch(() => { toggle.textContent = 'play'; });
      toggle.textContent = 'pause';
    } else if (btn.dataset.yt) {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1&rel=0&playsinline=1`;
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.title = btn.dataset.title ?? 'Talk';
      // Inline styles: scoped CSS does not reach elements created in script
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;display:block;';
      video.appendChild(iframe);
      video.hidden = false;
    }
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-listen]');
    if (!btn) return;
    if (btn === active && !dock.hidden) { document.getElementById('dock-close')!.click(); return; }
    start(btn);
  });

  document.getElementById('dock-close')!.addEventListener('click', () => {
    stop();
    dock.hidden = true;
    document.body.style.paddingBottom = '';
  });

  toggle.addEventListener('click', () => {
    if (audio.paused) { audio.play(); } else { audio.pause(); }
  });
  audio.addEventListener('play', () => { toggle.textContent = 'pause'; toggle.setAttribute('aria-label', 'Pause'); });
  audio.addEventListener('pause', () => { toggle.textContent = 'play'; toggle.setAttribute('aria-label', 'Play'); });
  audio.addEventListener('timeupdate', () => {
    if (audio.duration) seek.value = String((audio.currentTime / audio.duration) * 1000);
    timeEl.textContent = fmt(audio.currentTime);
  });
  seek.addEventListener('input', () => {
    if (audio.duration) audio.currentTime = (Number(seek.value) / 1000) * audio.duration;
  });
</script>
