---
/* A strong, angular portrait: the photo is cut with two chamfered corners (armor plate, kabuto crest)
   and sits on a solid gold slab offset behind it. The slab carries a Dong Son zigzag band and a drum
   medallion; a heavy bracket and crisp square nodes bring in the technical edge. No curves, no motion. */
interface Props { src: string; alt: string; }
const { src, alt } = Astro.props;

// Grid is 120 by 160. Photo box x 8 to 100, y 12 to 138; chamfer 26 on top-left and bottom-right.
const [x0, y0, x1, y1, c, off] = [8, 12, 100, 138, 26, 10];
const plate = (d = 0) =>
  `M${x0 + c + d} ${y0 + d} H${x1 + d} V${y1 - c + d} L${x1 - c + d} ${y1 + d} H${x0 + d} V${y0 + c + d} Z`;

// Dong Son triangle band along the slab's bottom edge, knocked out of the gold.
const tris: string[] = [];
for (let x = x0 + off + 6; x + 6 <= x1 - c + off; x += 6) {
  tris.push(`M${x} ${y1 + off} L${x + 3} ${y1 + off - 6} L${x + 6} ${y1 + off} Z`);
}
const medallion = { cx: 92, cy: 130 };
const nodes: [number, number][] = [[x0 + c, y0], [x0, y0 + c], [x1, y1 - c], [x1 - c, y1]];
---

<figure class="pf">
  <svg class="pf-art" viewBox="0 0 120 160" aria-hidden="true" focusable="false">
    <!-- solid gold slab, offset down and right -->
    <path d={plate(off)} fill="var(--color-accent)" />
    <path d={tris.join(' ')} fill="var(--color-canvas)" />
    <g fill="none" stroke="var(--color-canvas)" stroke-width="0.6">
      <circle cx={medallion.cx} cy={medallion.cy} r="4.8" />
      <circle cx={medallion.cx} cy={medallion.cy} r="3.1" />
    </g>
    <circle cx={medallion.cx} cy={medallion.cy} r="1.4" fill="var(--color-canvas)" />

    <!-- heavy armor edge along the top-left chamfer, and a bracket at the top-right -->
    <g fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="square">
      <path d={`M${x0 - 4} ${y0 + c - 4 + 1} L${x0 + c - 4 + 1} ${y0 - 4}`} />
      <path d={`M${x1 - 16} ${y0 - 5} H${x1 + 4} V${y0 + 15}`} />
    </g>

  </svg>

  <div class="pf-photo">
    <img src={src} alt={alt} width="1000" height="1500" decoding="async" />
  </div>

  <!-- outline and square nodes sit above the photo so its dark background keeps a clear edge -->
  <svg class="pf-art" viewBox="0 0 120 160" aria-hidden="true" focusable="false">
    <path d={plate()} fill="none" stroke="var(--color-accent)" stroke-width="0.7" stroke-opacity="0.85" />
    <g fill="var(--color-canvas)" stroke="var(--color-accent)" stroke-width="0.8">
      {nodes.map(([x, y]) => <rect x={x - 1.6} y={y - 1.6} width="3.2" height="3.2" />)}
    </g>
  </svg>
</figure>

<style>
  .pf { position: relative; width: 100%; max-width: 20rem; aspect-ratio: 3 / 4; margin: 0 0 2.5rem; }
  .pf-art { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  /* Same plate as the SVG path: 26 of 92 across and 26 of 126 down are cut from the two chamfered corners. */
  .pf-photo {
    position: absolute; left: 6.667%; top: 7.5%; width: 76.667%; height: 78.75%; overflow: hidden; background: #000;
    clip-path: polygon(28.26% 0, 100% 0, 100% 79.37%, 71.74% 100%, 0 100%, 0 20.63%);
  }
  .pf-photo img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 8%; filter: contrast(1.06); }
  /* Fade the bright shirt into the page and add a faint scan texture. */
  .pf-photo::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(to top, rgba(13, 13, 10, 0.55), rgba(13, 13, 10, 0) 40%),
      repeating-linear-gradient(to bottom, rgba(238, 238, 228, 0.03) 0 1px, transparent 1px 3px);
  }
  @media (max-width: 768px) { .pf { max-width: 15.5rem; margin-bottom: 0.5rem; } }
</style>
