---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/ui/PageHead.astro';
import PortraitFrame from '../components/ui/PortraitFrame.astro';
import { client, aboutQuery, portableTextToHtml, urlFor } from '../lib/sanity';
import { resolveAbout } from '../lib/about';

const about = resolveAbout(await client.fetch(aboutQuery));
const bodyHtml = about.body ? portableTextToHtml(about.body) : null;
// A portrait set in Sanity wins; otherwise the headshot shipped in public/ is used.
const portraitUrl = about.portrait ? urlFor(about.portrait as any).width(1000).auto('format').url() : '/headshot.jpg';
const portraitAlt = (about.portrait as any)?.alt || `Portrait of ${about.name}`;
---

<Layout title="About" description={about.title}>
  <div class="open-wrap">
    <PageHead title="about" />

    <div class="profile">
      <div class="profile-main">
        <header>
          <h2 class="name">{about.name}</h2>
          <figure class="quote">
            <svg class="quote-mark" width="24" height="19" viewBox="0 0 30 24" aria-hidden="true"><path fill="currentColor" d="M0 24V14.4C0 6.2 4.4 1.2 11.4 0l1.2 3.6C8.6 5 6.6 7.6 6.4 11H12v13H0Zm17 0V14.4C17 6.2 21.4 1.2 28.4 0l1.2 3.6c-4 1.4-6 4-6.2 7.4H29v13H17Z"/></svg>
            <blockquote>{about.quote}</blockquote>
            <figcaption>{about.quoteAttribution}</figcaption>
          </figure>
        </header>

        {bodyHtml ? (
          <div class="bio" set:html={bodyHtml} />
        ) : (
          <div class="bio">
            {about.bioFallback.map((p) => <p>{p}</p>)}
          </div>
        )}

        <section class="block" aria-labelledby="affiliations-label">
          <h2 id="affiliations-label" class="open-section-label">affiliations</h2>
          <ul class="open-rows">
            {about.affiliations.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="block" aria-labelledby="contact-label">
          <h2 id="contact-label" class="open-section-label">contact</h2>
          <ul class="open-rows">
            <li><a class="email" href={`mailto:${about.email}`}>{about.email}</a></li>
          </ul>
        </section>
      </div>

      <aside class="profile-side" aria-label="Expertise and programs">
        <PortraitFrame src={portraitUrl} alt={portraitAlt} />

        <section class="block" aria-labelledby="expertise-label">
          <h2 id="expertise-label" class="open-section-label">expertise</h2>
          <ul class="open-rows">
            {about.expertise.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="block" aria-labelledby="centers-label">
          <h2 id="centers-label" class="open-section-label">centers &amp; programs</h2>
          <ul class="open-rows">
            {about.centersAndPrograms.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </aside>
    </div>
  </div>
</Layout>

<style>
  /* .open-wrap lowercases inner pages. The profile copy is written with intentional casing
     (proper nouns, "i" mid-sentence), so it opts out; section labels stay lowercase. */
  .profile { margin-top: 4.5rem; display: grid; grid-template-columns: minmax(0, 1fr) 18rem; gap: 4.5rem; align-items: start; }
  .profile-main, .profile-side { min-width: 0; text-transform: none; }

  .name { margin-top: 0; font-family: var(--font-display); font-weight: 200; font-size: clamp(1.75rem, 3.5vw, 2.25rem); line-height: 1.05; letter-spacing: -0.02em; color: var(--color-ink); overflow-wrap: anywhere; }
  .quote { margin-top: 2.5rem; margin-bottom: 3rem; max-width: 38rem; }
  .quote-mark { display: block; color: var(--color-accent); margin-bottom: 1.25rem; }
  blockquote { font-family: var(--font-body); font-style: italic; font-size: clamp(1rem, 1.8vw, 1.125rem); line-height: 1.75; color: var(--color-ink); }
  figcaption { margin-top: 1.5rem; font-family: var(--font-display); font-weight: 400; font-style: italic; font-size: 0.8125rem; letter-spacing: 0.04em; text-transform: none; color: var(--color-muted); }

  .bio { font-family: var(--font-body); font-size: 1rem; line-height: 1.75; color: var(--color-ink-soft); max-width: 38rem; }
  .bio :global(p) { margin-bottom: 1.25rem; }
  .bio :global(p:last-child) { margin-bottom: 0; }
  .bio :global(a) { color: var(--color-accent); }

  .block { margin-top: 3rem; }
  .profile-side .block:first-child { margin-top: 0; }
  .profile-side .block + .block { margin-top: 2.5rem; }

  .email { color: var(--color-accent); text-decoration: none; }
  .email:hover { color: var(--color-ink); }


  @media (max-width: 960px) {
    .profile { margin-top: 2.5rem; grid-template-columns: 1fr; gap: 2.5rem; }
    /* On phones: portrait, then name, quote and bio, then the sidebar lists. */
    .profile-side { display: contents; }
    .profile-side :global(.pf) { order: -2; margin-bottom: 0; }
    .profile-main { order: -1; }
    .profile-side .block { margin-top: 0; }
    }
</style>
