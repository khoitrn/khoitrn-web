---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/ui/PageHead.astro';
import Glyph from '../components/ui/Glyph.astro';
import { client, aboutQuery, nowQuery, portableTextToHtml, formatDate } from '../lib/sanity';

const [about, now] = await Promise.all([client.fetch(aboutQuery), client.fetch(nowQuery)]);
const bodyHtml = about?.body ? portableTextToHtml(about.body) : null;
const headline = about?.headline ?? 'Student, founder, engineer.';
const currentItems: string[] = about?.currentItems ?? [
  'Studying at Texas A&M University',
  "Building — ask me what's current",
  'Writing here, thinking out loud',
];
const email = about?.email ?? 'khoi@tamu.edu';
const nowHtml = now?.body ? portableTextToHtml(now.body) : null;
const nowUpdated = now?.updatedAt ? formatDate(now.updatedAt) : null;
---

<Layout title="About">
  <div class="open-wrap">
    <PageHead title="about" sub={headline} />

    <div class="about-grid">
      <!-- A photo can go here (public/photo.jpg); until then the point cloud holds the space -->
      <div class="about-photo" aria-hidden="true">
        <Glyph kind="sphere" width={300} accent />
      </div>

      <div class="about-text">
        {bodyHtml ? (
          <div class="about-prose" set:html={bodyHtml} />
        ) : (
          <div class="about-prose">
            <p class="lead">I'm Khoi Tran, a student at Texas A&amp;M University, building things at the intersection of technology, product, and entrepreneurship.</p>
            <p>I started writing code because I wanted to build things I cared about. That curiosity led me to engineering, then to product thinking, and eventually to starting companies.</p>
            <p class="quiet">I care deeply about craft: code that's readable, products that are intuitive, and writing that earns its reader's attention.</p>
          </div>
        )}

        <section id="right-now" class="right-now" aria-labelledby="right-now-title">
          <div class="right-now-top">
            <h2 id="right-now-title">right now</h2>
            {nowUpdated && <span class="open-label">updated {nowUpdated}</span>}
          </div>
          {nowHtml ? (
            <div class="about-prose" set:html={nowHtml} />
          ) : (
            <div class="about-prose">
              <p>Building a new project, still early, focused on getting the core right before anything else. Finishing the semester at Texas A&amp;M, and thinking about what makes a product actually good: the gap between clever and useful.</p>
            </div>
          )}
        </section>

        <ul class="current">
          {currentItems.map((item) => <li>{item}</li>)}
        </ul>

        <a class="email" href={`mailto:${email}`}>{email} →</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .about-grid { margin-top: 4.5rem; display: grid; grid-template-columns: 21rem 1fr; gap: 5rem; align-items: start; }
  .about-photo {
    aspect-ratio: 3 / 4; display: flex; align-items: center; justify-content: center;
    background: radial-gradient(70% 60% at 40% 40%, rgba(196, 144, 58, 0.18), rgba(13, 13, 10, 0) 75%);
  }

  .about-prose { font-family: var(--font-body); font-size: 1.125rem; line-height: 1.8; color: var(--color-ink-soft); max-width: none; }
  .about-prose :global(p) { margin-bottom: 1.5rem; }
  .about-prose :global(p.lead) { font-size: 1.5rem; line-height: 1.65; color: var(--color-ink); margin-bottom: 1.75rem; }
  .about-prose :global(p.quiet) { color: var(--color-muted); }
  .about-prose :global(a) { color: var(--color-accent); }

  .right-now { margin-top: 4rem; padding-top: 1.75rem; border-top: 1px solid rgba(196, 144, 58, 0.5); }
  .right-now-top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 1rem; }
  .right-now h2 { font-family: var(--font-display); font-weight: 300; font-size: 1.75rem; color: var(--color-accent); }
  .right-now .about-prose :global(p:last-child) { margin-bottom: 0; }

  .current { margin-top: 3.5rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem; list-style: none; }
  .current li { font-family: var(--font-body); font-size: 1.0625rem; line-height: 1.6; color: var(--color-ink-soft); }

  .email { display: inline-block; margin-top: 3.5rem; font-family: var(--font-display); font-weight: 300; font-size: 0.9375rem; letter-spacing: 0.04em; color: var(--color-accent); text-decoration: none; padding: 0.4rem 0; }
  .email:hover { color: var(--color-ink); }

  @media (max-width: 960px) {
    .about-grid { grid-template-columns: 1fr; gap: 3rem; }
    .about-photo { display: none; }
    .current { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
