---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Khoi Tran.">
  <div class="contact-page page-pad">
    <div class="contact-wrap">

      <div class="contact-header">
        <p class="animate-fade-up" style="font-family:var(--font-display); font-weight:300; font-size:0.65rem; letter-spacing:0.3em; text-transform:uppercase; color:var(--color-muted); margin-bottom:1.25rem;">Contact</p>
        <h1 class="animate-fade-up delay-1" style="font-family:var(--font-display); font-weight:300; font-size:clamp(2.5rem,6vw,4.5rem); line-height:1.1; letter-spacing:-0.02em; color:var(--color-ink);">
          Let's talk.
        </h1>
      </div>

      <div class="reveal">
        <p style="font-family:var(--font-body); font-size:clamp(1rem,2vw,1.125rem); color:var(--color-ink-soft); line-height:1.85; margin-bottom:3rem;">
          I'm always open to interesting conversations — whether it's about a project you're building, an idea you're sitting on, or just something worth discussing.
        </p>

        <div>
          {[
            { label: 'Email',    href: 'mailto:khoi@tamu.edu',              display: 'khoi@tamu.edu' },
            { label: 'GitHub',   href: 'https://github.com/khoitrn',        display: '@khoitrn' },
            { label: 'LinkedIn', href: 'https://linkedin.com/in/khoitrn',   display: 'Khoi Tran' },
          ].map(({ label, href, display }) => (
            <div class="contact-row">
              <span class="contact-label">{label}</span>
              <a
                href={href}
                target={href.startsWith('http') ? '_blank' : undefined}
                rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="contact-link"
              >
                {display}
              </a>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</Layout>

<style>
  .contact-wrap {
    max-width: 720px;
    margin: 0 auto;
  }
  .contact-header {
    margin-bottom: clamp(2rem, 5vw, 6rem);
    padding-bottom: 2rem;
  }
  .contact-row {
    display: flex;
    align-items: baseline;
    gap: 2rem;
    padding: 1.5rem 0;
  }
  .contact-label {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
    width: 6rem;
    flex-shrink: 0;
  }
  .contact-link {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.9rem;
    color: var(--color-ink);
    text-decoration: none;
    transition: color 0.3s;
  }
  .contact-link:hover { color: var(--color-accent); }

  @media (max-width: 400px) {
    /* On very small phones, stack label above link */
    .contact-row { flex-direction: column; gap: 0.35rem; }
    .contact-label { width: auto; }
  }
</style>
