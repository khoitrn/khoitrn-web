---
import Layout from '../layouts/Layout.astro';
import Background from '../components/Background.astro';

const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/writing', label: 'Writing' },
  { href: '/talks', label: 'Talks' },
  { href: '/now', label: 'Now' },
  { href: '/about', label: 'About' },
];
const socialLinks = [
  { href: 'https://github.com/khoitrn', label: 'GitHub' },
  { href: 'https://linkedin.com/in/khoitrn', label: 'LinkedIn' },
  { href: 'https://x.com/khoitrn', label: 'X' },
  { href: 'mailto:khoi@tamu.edu', label: 'Email' },
];
const { pathname } = Astro.url;
---

<Layout title="Khoi Tran" hideNav={true}>

  <Background />

  <div class="home-stage">
    <header class="home-top">
      <a href="/" class="home-mark" aria-label="Khoi Tran — home">
        <svg viewBox="0 0 320 80" class="home-mark-svg" aria-hidden="true">
          <path fill="var(--color-ink)" d="M 18 10 C 15 9 12 11 12 15 L 12 70 C 12 74 15 76 18 75 C 21 76 24 74 24 70 L 24 17 C 24 12 21 9 18 10 Z"/>
          <path fill="var(--color-ink)" d="M 24 34 L 24 29 L 58 12 C 60 11 62 12 61 15 C 60 17 28 35 26 36 Z"/>
          <path fill="var(--color-ink)" d="M 24 44 L 20 40 L 58 72 C 60 74 60 77 57 77 C 55 77 52 75 50 73 L 24 50 Z"/>
          <path fill="var(--color-ink)" d="M 94 22 C 91 21 88 23 88 27 L 88 68 C 88 72 91 74 94 73 C 97 74 100 72 100 68 L 100 27 C 100 23 97 21 94 22 Z"/>
          <path fill="var(--color-ink)" d="M 70 30 C 70 28 72 26 74 27 L 114 27 C 116 27 118 29 117 31 C 116 33 114 33 112 32 L 72 32 C 70 32 69 31 70 30 Z"/>
          <path fill="var(--color-ink)" d="M 148 36 C 145 35 142 37 142 41 L 142 70 C 142 74 145 76 148 75 C 151 76 154 74 154 70 L 154 45 C 154 41 151 35 148 36 Z"/>
          <path fill="var(--color-ink)" d="M 154 42 C 158 35 168 28 178 27 C 181 26 183 28 182 31 C 181 33 178 33 176 34 C 168 35 160 40 156 46 Z"/>
          <path fill="var(--color-ink)" d="M 208 36 C 205 35 202 37 202 41 L 202 70 C 202 74 205 76 208 75 C 211 76 214 74 214 70 L 214 41 C 214 37 211 35 208 36 Z"/>
          <path fill="var(--color-ink)" d="M 214 42 C 218 35 228 28 238 28 C 244 28 248 32 249 38 L 249 70 C 249 74 252 76 255 75 C 258 76 261 74 261 70 L 261 38 C 261 28 252 18 238 18 C 224 18 216 28 214 38 Z"/>
          <path fill="var(--color-ink)" d="M 249 38 C 249 34 252 32 255 33 C 258 32 261 34 261 38 L 261 70 C 261 74 258 76 255 75 C 252 76 249 74 249 70 Z"/>
        </svg>
      </a>

      <nav class="home-nav" aria-label="Primary">
        <ul>
          {navLinks.map(({ href, label }) => (
            <li>
              <a href={href} class="home-nav-link" aria-current={pathname.startsWith(href) ? 'page' : undefined}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="home-top-right">
        <a href="/beliefs" class="home-star-btn" aria-label="Beliefs">
          <svg class="home-star-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" overflow="visible">
            <path class="home-star-glow"  d="M12 0.5 L13.5 10.5 L23.5 12 L13.5 13.5 L12 23.5 L10.5 13.5 L0.5 12 L10.5 10.5 Z"/>
            <path class="home-star-shape" d="M12 0.5 L13.5 10.5 L23.5 12 L13.5 13.5 L12 23.5 L10.5 13.5 L0.5 12 L10.5 10.5 Z"/>
            <path class="home-star-inner" d="M12 5.5 L13 11 L18.5 12 L13 13 L12 18.5 L11 13 L5.5 12 L11 11 Z"/>
          </svg>
        </a>
        <ul class="home-social">
          {socialLinks.map(({ href, label }) => (
            <li>
              <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener noreferrer' : undefined} class="home-social-link">{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <button class="hamburger home-hamburger" id="home-hamburger-btn" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </header>

    <div class="mobile-menu" id="home-mobile-menu">
      <button class="mobile-menu-close" id="home-mobile-menu-close">Close</button>
      {navLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
      <a href="/beliefs">Beliefs</a>
      <div class="home-mobile-social">
        {socialLinks.map(({ href, label }) => (
          <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}>{label}</a>
        ))}
      </div>
    </div>

    <main class="home-hero-copy">
      <p class="home-lede">I'm a student and founder based in Texas, building at the intersection of technology and product — currently figuring out what it means to start something from scratch.</p>
      <div class="status-row">
        <span class="status-dot" id="status-dot" aria-hidden="true"></span>
        <span class="status-time" id="status-time"></span>
        <span class="status-sep">·</span>
        <span class="status-loc">College Station, TX</span>
      </div>
    </main>
  </div>

  <footer class="home-footer">
    <div class="home-footer-inner">
      <p class="footer-copy">© {new Date().getFullYear()} Khoi Tran</p>
      <div class="footer-links">
        {[['https://github.com/khoitrn','GitHub'],['https://linkedin.com/in/khoitrn','LinkedIn'],['mailto:khoi@tamu.edu','Email']].map(([href,label]) => (
          <a href={href} target={href.startsWith('http')?'_blank':undefined} rel={href.startsWith('http')?'noopener noreferrer':undefined} class="footer-link">{label}</a>
        ))}
      </div>
    </div>
  </footer>

</Layout>

<style>
  /* ── Hero stage: full viewport, canvas behind it ── */
  .home-stage {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    z-index: 2;
  }

  /* ── Top bar ── */
  .home-top {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.75rem clamp(1.25rem, 3vw, 3rem);
  }
  .home-mark { display: flex; align-items: center; flex-shrink: 0; opacity: 0.9; transition: opacity 0.4s; }
  .home-mark:hover { opacity: 1; }
  .home-mark-svg { width: 76px; height: 19px; display: block; }

  .home-nav {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .home-nav ul { display: flex; align-items: center; gap: clamp(1.25rem, 2.5vw, 2.5rem); list-style: none; margin: 0; padding: 0; }
  .home-nav-link {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.35s;
  }
  .home-nav-link:hover,
  .home-nav-link[aria-current="page"] { color: var(--color-accent); }
  .home-nav-link:focus-visible { outline: 1px solid var(--color-accent); outline-offset: 4px; }

  .home-top-right { display: flex; align-items: center; gap: 1.5rem; flex-shrink: 0; }
  .home-social { display: flex; align-items: center; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
  .home-social-link {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.4s;
  }
  .home-social-link:hover { color: var(--color-accent); }
  .home-social-link:focus-visible { outline: 1px solid var(--color-accent); outline-offset: 3px; }

  /* Star mark — slow spin, link to /beliefs */
  .home-star-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    text-decoration: none;
    overflow: visible;
    position: relative;
  }
  .home-star-btn::after {
    content: '';
    position: absolute;
    inset: -6px;
    background: conic-gradient(from 0deg, transparent 0%, rgba(196,144,58,0.2) 15%, transparent 30%);
    border-radius: 50%;
    animation: home-star-spin 48s linear infinite;
    pointer-events: none;
  }
  @keyframes home-star-spin { to { transform: rotate(360deg); } }
  .home-star-svg { width: 20px; height: 20px; overflow: visible; display: block; }
  .home-star-glow {
    fill: none; stroke: var(--color-accent); stroke-width: 1.5;
    opacity: 0; filter: blur(2.5px);
    animation: home-star-pulse 3.5s ease-in-out infinite;
  }
  .home-star-shape {
    fill: none; stroke: var(--color-accent); stroke-width: 1.2; stroke-linejoin: round;
    animation: home-star-breathe 3.5s ease-in-out infinite;
  }
  .home-star-inner {
    fill: none; stroke: var(--color-accent); stroke-width: 0.8; opacity: 0.4;
    animation: home-star-breathe 3.5s ease-in-out infinite 0.4s;
  }
  @keyframes home-star-breathe { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }
  @keyframes home-star-pulse { 0%, 100% { opacity: 0; } 50% { opacity: 0.6; } }
  .home-star-btn:hover .home-star-shape,
  .home-star-btn:hover .home-star-inner { opacity: 1; }
  .home-star-btn:focus-visible { outline: 1px solid var(--color-accent); outline-offset: 4px; }

  /* Mobile hamburger (desktop nav + top-right collapse into it) */
  .home-hamburger { display: none; }

  @media (max-width: 768px) {
    .home-nav, .home-top-right { display: none; }
    .home-hamburger { display: flex; }
    .home-top { padding: 1.25rem 1.5rem; }
  }

  .home-mobile-social {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }
  .home-mobile-social a {
    font-size: 0.9rem !important;
    letter-spacing: 0.08em !important;
  }

  /* ── Hero copy — bottom-left, over the Background's scrim ── */
  .home-hero-copy {
    margin-top: auto;
    max-width: 38rem;
    padding: 0 clamp(1.25rem, 3vw, 3rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  .home-lede {
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 1.9vw, 1.3125rem);
    line-height: 1.65;
    color: var(--color-ink-soft);
    margin: 0 0 1.25rem;
    text-wrap: pretty;
  }
  .status-row { display: flex; align-items: center; gap: 0.6rem; }
  .status-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--color-accent); flex-shrink: 0;
    transition: background 0.6s;
  }
  .status-dot.offline { background: var(--color-muted); opacity: 0.5; }
  .status-time, .status-loc {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .status-sep { color: var(--color-border); }

  @media (max-width: 768px) {
    .home-hero-copy { padding-bottom: 3.5rem; }
  }

  /* ── Footer ── */
  .home-footer { position: relative; z-index: 2; margin-top: 0; }
  .home-footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem clamp(1.25rem, 4vw, 3rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .footer-copy {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .footer-links { display: flex; gap: 2rem; flex-wrap: wrap; }
  .footer-link {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.4s;
  }
  .footer-link:hover { color: var(--color-ink); }
</style>

<script>
  // ── Mobile menu ──────────────────────────────────────────
  const btn   = document.getElementById('home-hamburger-btn');
  const menu  = document.getElementById('home-mobile-menu');
  const close = document.getElementById('home-mobile-menu-close');

  btn?.addEventListener('click', () => {
    menu?.classList.add('open');
    btn.setAttribute('aria-expanded', 'true');
  });
  close?.addEventListener('click', () => {
    menu?.classList.remove('open');
    btn?.setAttribute('aria-expanded', 'false');
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
    })
  );

  // ── CST clock ────────────────────────────────────────────
  const timeEl = document.getElementById('status-time') as HTMLElement | null;
  const dotEl  = document.getElementById('status-dot')  as HTMLElement | null;

  function updateClock() {
    const now = new Date();
    const cst = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Chicago',
      hour: 'numeric', minute: '2-digit', hour12: true,
    }).format(now);
    const hour = parseInt(new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Chicago', hour: 'numeric', hour12: false,
    }).format(now), 10);
    if (timeEl) timeEl.textContent = cst + ' CST';
    if (dotEl)  dotEl.classList.toggle('offline', !(hour >= 8 && hour < 23));
  }

  updateClock();
  setInterval(updateClock, 30_000);
</script>
