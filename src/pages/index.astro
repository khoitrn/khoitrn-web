<script>
  import Lenis from 'lenis';

  // ── Shoji panel animation ──────────────────────────────────
  const panelL  = document.getElementById('panel-left')    as HTMLElement;
  const panelR  = document.getElementById('panel-right')   as HTMLElement;
  const overlay = document.getElementById('hero-overlay')  as HTMLElement;
  const leftNav = document.getElementById('hero-left-nav') as HTMLElement;
  const hint    = document.getElementById('hero-scroll-hint') as HTMLElement;

  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  let cur = 0;
  let done = false;

  function updateShoji() {
    if (done) return;

    const raw  = Math.max(0, Math.min(window.scrollY / (window.innerHeight * 1.6), 1));
    cur = lerp(cur, raw, 0.048);
    const p = cur;

    const mobile = window.innerWidth <= 768;

    if (mobile) {
      panelL.style.transform = `translateY(${-p * 105}%)`;
    } else {
      panelL.style.transform = `translateX(${-p * 105}%)`;
      if (panelR) panelR.style.transform = `translateX(${p * 105}%)`;
    }

    // Name/tagline fades OUT as panels open
    overlay.style.opacity = Math.max(0, 1 - p * 2.4).toString();

    // Left nav: show when panels are mostly open, hide when nearly closed
    const showNav = raw > 0.5;
    leftNav.classList.toggle('nav-open', showNav);

    // Scroll hint fades early
    if (hint) hint.style.opacity = Math.max(0, 1 - p * 6).toString();

    if (p > 1.02 && raw > 1.02) {
      done = true;
      panelL.style.display = 'none';
      if (panelR) panelR.style.display = 'none';
      overlay.style.display = 'none';
      return;
    }

    requestAnimationFrame(updateShoji);
  }

  window.addEventListener('scroll', () => {
    if (done && window.scrollY < window.innerHeight * 0.08) {
      done = false;
      panelL.style.display = '';
      if (panelR) panelR.style.display = '';
      overlay.style.display = '';
      requestAnimationFrame(updateShoji);
    }
  }, { passive: true });

  requestAnimationFrame(updateShoji);

  // Lenis smooth scroll
  new Lenis({ autoRaf: true });

  // ── Mobile menu ────────────────────────────────────────────
  const heroBtn   = document.getElementById('hero-hamburger');
  const heroMenu  = document.getElementById('hero-mobile-menu');
  const heroClose = document.getElementById('hero-menu-close');
  heroBtn?.addEventListener('click',   () => heroMenu?.classList.add('open'));
  heroClose?.addEventListener('click', () => heroMenu?.classList.remove('open'));
  heroMenu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => heroMenu?.classList.remove('open')));

  // ── CST clock ──────────────────────────────────────────────
  const timeEl = document.getElementById('status-time') as HTMLElement | null;
  const dotEl  = document.getElementById('status-dot')  as HTMLElement | null;

  function updateClock() {
    const now = new Date();
    const cst = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Chicago',
      hour: 'numeric', minute: '2-digit', hour12: true,
    }).format(now);
    const hour = parseInt(new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Chicago', hour: 'numeric', hour12: false,
    }).format(now), 10);
    if (timeEl) timeEl.textContent = cst + ' cst';
    if (dotEl)  dotEl.classList.toggle('offline', !(hour >= 8 && hour < 23));
  }

  updateClock();
  setInterval(updateClock, 30_000);

  // ── Talks: click poster → inline YouTube embed ─────────────
  document.querySelectorAll<HTMLElement>('.talk-embed[data-yt]').forEach(wrap => {
    const btn = wrap.querySelector('.talk-embed-poster');
    btn?.addEventListener('click', () => {
      const id = wrap.dataset.yt;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.title = 'Talk video';
      wrap.innerHTML = '';
      wrap.appendChild(iframe);
    });
  });
</script>
