---
import Layout from '../layouts/Layout.astro';
import Background from '../components/Background.astro';
import Gate from '../components/Gate.astro';
import { client, settingsQuery } from '../lib/sanity';

const settings = await client.fetch(settingsQuery);

const heroTagline = settings?.heroTagline ?? 'Student · Founder · Engineer';
const heroParagraph = settings?.heroParagraph ?? 'I build things and think about building things — products, companies, and the ideas that hold them together.';

const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/writing', label: 'Writing' },
  { href: '/talks', label: 'Talks' },
  { href: '/about', label: 'About' },
];
const socialLinks = [
  { href: 'https://github.com/khoitrn', label: 'GitHub' },
  { href: 'https://linkedin.com/in/khoitrn', label: 'LinkedIn' },
  { href: 'https://x.com/khoitrn', label: 'X' },
  { href: 'mailto:khoi@tamu.edu', label: 'Email' },
];
---

<Layout title="Khoi Tran" hideNav={true} smoothScroll={false}>
  <Background />
  <Gate tagline={heroTagline} blurb={heroParagraph} />

  <h1 class="sr-only">Khoi Tran</h1>

  <div class="stage">
    <header class="top">
      <a class="logo chrome" id="home-logo" href="/" aria-label="Khoi Tran, home">Khoi Tran</a>
      <nav class="nav chrome" id="home-nav" aria-label="Primary">
        {navLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
      </nav>
      <div class="top-right chrome" id="home-right">
        <a class="mark-link" href="/beliefs" aria-label="Beliefs">
          <svg class="mark" viewBox="-20 -20 40 40" aria-hidden="true"><path d="M0 -18 Q2.6 -2.6 18 0 Q2.6 2.6 0 18 Q-2.6 2.6 -18 0 Q-2.6 -2.6 0 -18Z" fill="currentColor"></path></svg>
        </a>
      </div>
    </header>

    <div class="bottom">
      <section class="hero chrome" id="home-hero" aria-label="Introduction">
        <p class="lede">I'm a student and founder based in Texas, building at the intersection of technology and product — currently figuring out what it means to start something from scratch.</p>
        <div class="meta">
          <span class="dot" id="home-dot" aria-hidden="true"></span>
          <span id="home-clock"></span>
          <span>College Station, TX</span>
          <span class="social">
            {socialLinks.map(({ href, label }) => (
              <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}>{label}</a>
            ))}
          </span>
        </div>
      </section>

      <aside class="story chrome" id="home-story" aria-label="Story">
        <p class="story-line" id="story-line" aria-live="polite"></p>
        <div class="story-ticks" aria-hidden="true">
          {Array.from({ length: 7 }, () => <i class="story-tick"></i>)}
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  /* fixed stage over the canvas; only the links and buttons take pointer events */
  .stage {
    position: fixed; inset: 0; z-index: 4; box-sizing: border-box;
    display: flex; flex-direction: column;
    padding-block: clamp(16px, 2.6vw, 32px);
    padding-left: max(20px, env(safe-area-inset-left, 0px));
    padding-right: max(20px, env(safe-area-inset-right, 0px));
    pointer-events: none;
  }
  .stage :is(a, button) { pointer-events: auto; }
  /* hidden until the gate opens; the script fades them in and sets inert while they are invisible */
  .chrome { opacity: 0; }
  :global(html[data-gate='skip']) .chrome { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .chrome { opacity: 1; } }

  .top { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; }
  .logo { justify-self: start; font: 400 1.25rem/1 var(--font-serif); letter-spacing: 0.02em; color: var(--color-ink); text-decoration: none; padding: 0.4rem 0; }
  .nav { display: flex; gap: clamp(18px, 3vw, 44px); }
  .nav a, .social a {
    font: 400 0.875rem/1 var(--font-ui); letter-spacing: 0.03em; color: var(--color-muted); text-decoration: none;
    padding: 0.7rem 0.1rem; transition: color 0.25s ease;
  }
  .nav a:hover, .social a:hover { color: var(--color-accent); }
  .logo:focus-visible, .nav a:focus-visible, .social a:focus-visible, .mark-link:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; border-radius: 2px; }
  .top-right { justify-self: end; display: flex; align-items: center; }
  .mark-link { display: flex; padding: 8px; color: var(--color-accent); }
  .mark { width: 30px; height: 30px; flex: none; filter: drop-shadow(0 0 9px rgba(200, 148, 60, 0.55)); animation: mark-spin 48s linear infinite; }
  @keyframes mark-spin { to { transform: rotate(360deg); } }

  .bottom { margin-top: auto; display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; }
  .hero { max-width: 40rem; }
  .lede { max-width: 30rem; }
  .lede { font: 400 clamp(1rem, 1.35vw, 1.2rem)/1.6 var(--font-serif); color: var(--color-ink-soft); margin: 0 0 1.2rem; text-wrap: pretty; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.7rem; font: 400 0.8rem/1 var(--font-ui); letter-spacing: 0.02em; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .meta .social { display: flex; flex-wrap: wrap; gap: 0 clamp(14px, 2vw, 22px); }
  .meta .social a { font-size: 0.8rem; padding: 0.5rem 0; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-accent); animation: dot-pulse 3.2s ease-in-out infinite; transition: background 0.6s; }
  .dot.offline { background: var(--color-muted); opacity: 0.5; animation: none; }
  @keyframes dot-pulse { 50% { opacity: 0.35; } }

  .story { width: min(19rem, 38vw); text-align: right; }
  .story-line { font: italic 400 0.95rem/1.5 var(--font-serif); color: var(--color-ink-soft); margin: 0 0 0.9rem; min-height: 4.5em; text-wrap: pretty; }
  /* every tick is 26px wide; the inactive ones are scaled down, so the change animates on transform, not layout */
  .story-ticks { display: flex; justify-content: flex-end; gap: 0; }
  .story-tick { width: 26px; height: 2px; background: #3a382f; transform: scaleX(0.6); transform-origin: right; transition: background 0.5s ease, transform 0.5s ease; }
  .story-tick:global(.on) { background: var(--color-accent); transform: scaleX(1); }

  @media (max-width: 760px) {
    .top { grid-template-columns: 1fr auto; }
    .nav { grid-column: 1 / -1; grid-row: 2; justify-content: space-between; }
    .bottom { flex-direction: column; align-items: stretch; gap: 20px; }
    .story { width: auto; text-align: left; }
    .story-ticks { justify-content: flex-start; }
    .story-tick { transform-origin: left; }
    .story-line { min-height: 3em; }
    .meta .social { flex-basis: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .mark, .dot { animation: none; } }
</style>

<script>
  import { smooth } from '../lib/gate/math.ts';
  import { onFrame } from '../lib/gate/state.ts';

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const logo = $('home-logo'), nav = $('home-nav'), hero = $('home-hero'), right = $('home-right'), story = $('home-story');

  /* page content arrives in order as the gate opens: logo, nav, lede and links, star, then the story */
  function reveal(el: HTMLElement, a: number, b: number, p: number) {
    const o = smooth((p - a) / (b - a));
    el.style.opacity = o.toFixed(3);
    const hidden = o < 0.3;
    el.style.pointerEvents = hidden ? 'none' : '';
    el.toggleAttribute('inert', hidden);
  }
  onFrame((p) => {
    reveal(logo, 0.7, 0.84, p); reveal(nav, 0.72, 0.86, p); reveal(hero, 0.8, 0.94, p); reveal(right, 0.86, 0.98, p); reveal(story, 0.82, 0.97, p);
  });

  /* live clock in College Station, with a muted dot overnight */
  const clock = $('home-clock'), dot = $('home-dot');
  const fmt = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Chicago', timeZoneName: 'short' });
  const hourFmt = new Intl.DateTimeFormat('en-US', { hour: 'numeric', hour12: false, timeZone: 'America/Chicago' });
  function tick() {
    const now = new Date();
    clock.textContent = fmt.format(now);
    const h = parseInt(hourFmt.format(now), 10) % 24;
    dot.classList.toggle('offline', !(h >= 8 && h < 23));
  }
  tick(); setInterval(tick, 1000);
</script>
