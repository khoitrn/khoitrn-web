---
import Layout from '../layouts/Layout.astro';
import { client, featuredProjectsQuery, recentPostsQuery, settingsQuery, talksQuery, formatDateShort } from '../lib/sanity';

const [projects, posts, settings, allTalks] = await Promise.all([
  client.fetch(featuredProjectsQuery),
  client.fetch(recentPostsQuery),
  client.fetch(settingsQuery),
  client.fetch(talksQuery),
]);

const heroTagline  = settings?.heroTagline  ?? 'Student · Founder · Engineer';
const heroParagraph = settings?.heroParagraph ?? 'I build things and think about building things — products, companies, and the ideas that hold them together.';

// Extract YouTube ID from a talk's mediaUrl for thumbnails
function ytId(url: string | null | undefined): string | null {
  if (!url) return null;
  const m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([A-Za-z0-9_-]{11})/);
  return m ? m[1] : null;
}

// Top 3 talks for the home page (already ordered by date in the query)
const homeTalks = (allTalks ?? []).slice(0, 3).map((t: any) => ({
  ...t,
  youtubeId: ytId(t.mediaUrl),
  year: t.date ? new Date(t.date).getFullYear() : '',
}));
---

<Layout title="Khoi Tran" hideNav={true}>

  <!-- ── SHOJI PANELS (fixed, slide on scroll) ─────────────────── -->
  <div id="panel-left"  class="shoji-panel" aria-hidden="true"><div class="panel-img panel-img-left"></div></div>
  <div id="panel-right" class="shoji-panel" aria-hidden="true"><div class="panel-img panel-img-right"></div></div>

  <!-- ── LEFT NAV — hidden during shoji, fades in as panels open ── -->
  <nav id="hero-left-nav" class="hero-left-nav">
    {[
      { href: '/about',   label: 'about' },
      { href: '/work',    label: 'work' },
      { href: '/writing', label: 'writing' },
      { href: '/talks',   label: 'talks' },
    ].map(({ href, label }) => (
      <a href={href} class="hero-nav-link"
        onmouseover="this.style.color='rgba(255,255,255,0.92)'"
        onmouseout="this.style.color='rgba(255,255,255,0.4)'"
      >{label}</a>
    ))}

    <!-- Diamond — sits below nav links, links to beliefs page -->
    <a href="/beliefs" class="hero-diamond-btn" aria-label="Beliefs">
      <svg class="nav-star-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" overflow="visible">
        <path class="nav-star-glow"  d="M12 0.5 L13.5 10.5 L23.5 12 L13.5 13.5 L12 23.5 L10.5 13.5 L0.5 12 L10.5 10.5 Z"/>
        <path class="nav-star-shape" d="M12 0.5 L13.5 10.5 L23.5 12 L13.5 13.5 L12 23.5 L10.5 13.5 L0.5 12 L10.5 10.5 Z"/>
        <path class="nav-star-inner" d="M12 5.5 L13 11 L18.5 12 L13 13 L12 18.5 L11 13 L5.5 12 L11 11 Z"/>
      </svg>
    </a>
  </nav>

  <!-- ── HERO OVERLAY (name + tagline — fades out as panels open) ── -->
  <div id="hero-overlay">

    <button class="hero-hamburger" id="hero-hamburger" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>

    <div class="hero-center-text">
      <p class="hero-tagline">{heroTagline}</p>
      <h1 class="hero-name">khoi tran</h1>
      <p class="hero-para">{heroParagraph}</p>
    </div>

    <div id="hero-scroll-hint">
      <span>scroll</span>
    </div>

  </div>

  <!-- ── MOBILE MENU ──────────────────────────────────────────── -->
  <div class="hero-mobile-menu" id="hero-mobile-menu">
    <button class="hero-menu-close" id="hero-menu-close">close</button>
    <a href="/work">work</a>
    <a href="/writing">writing</a>
    <a href="/talks">talks</a>
    <a href="/about">about</a>
  </div>

  <div class="content-wrap home-body">

    <!-- 100vh spacer — panels open over this, about appears behind them -->
    <div class="shoji-spacer" aria-hidden="true"></div>

    <!-- ── About ── -->
    <section class="home-section reveal">
      <p class="about-text">I'm a student and founder based in Texas, building at the intersection of technology and product.</p>
      <p class="about-sub">I care about the craft of making — code that's clean, products that are clear, and ideas that have earned their place.</p>

      <!-- Status + links -->
      <div class="status-row">
        <span class="status-dot" id="status-dot" aria-hidden="true"></span>
        <span class="status-time" id="status-time"></span>
        <span class="status-sep">·</span>
        <span class="status-loc">college station, tx</span>
      </div>
      <div class="social-links">
        {[
          { href: 'https://github.com/khoitrn',         label: 'github' },
          { href: 'https://linkedin.com/in/khoitrn',    label: 'linkedin' },
          { href: 'https://x.com/khoitrn',              label: 'x' },
          { href: 'mailto:khoi@tamu.edu',               label: 'email' },
        ].map(({ href, label }) => (
          <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener noreferrer' : undefined} class="social-link">{label}</a>
        ))}
      </div>
      <a href="/about" class="section-link">more about me →</a>
    </section>


    <!-- ── Currently ── -->
    <section class="home-section reveal">
      <span class="section-label">currently</span>
      <p class="currently-text">Building products, writing more, and figuring out what it means to start something from scratch.</p>
      <a href="/now" class="section-link">full now page →</a>
    </section>


    <!-- ── Work + Writing — 2-col ── -->
    <section class="home-section reveal">
      <div class="grid-work-writing">

        <div class="work-col">
          <div class="col-header">
            <span class="section-label">work</span>
            <a href="/work" class="col-link">all →</a>
          </div>
          {projects.length > 0 ? (
            <div>
              {projects.map((item: any, i: number) => (
                <a href={`/work/${item.slug.current}`} class="col-row" style={`transition-delay:${i*70}ms;`}>
                  <span class="col-row-title">{item.title}</span>
                  <span class="col-row-meta"><span>{item.category}</span><span>{item.year}</span></span>
                </a>
              ))}
            </div>
          ) : (
            <p class="empty-note">Projects coming soon.</p>
          )}
        </div>

        <div class="col-rule" aria-hidden="true"></div>

        <div class="writing-col">
          <div class="col-header">
            <span class="section-label">writing</span>
            <a href="/writing" class="col-link">all →</a>
          </div>
          {posts.length > 0 ? (
            <div>
              {posts.map((post: any, i: number) => (
                <a href={`/writing/${post.slug.current}`} class="col-row" style={`transition-delay:${i*70}ms;`}>
                  <span class="col-row-title">{post.title}</span>
                  <span class="col-row-meta">
                    <span>{post.category}</span>
                    <span>{formatDateShort(post.publishedAt)}</span>
                  </span>
                </a>
              ))}
            </div>
          ) : (
            <p class="empty-note">Writing coming soon.</p>
          )}
        </div>

      </div>
    </section>


    <!-- ── Talks ── -->
    <section id="talks" class="home-section reveal">
      <span class="section-label" style="display:block; margin-bottom:3rem;">talks</span>
      <div class="talks-stack">
        {homeTalks.map((talk: any, i: number) => (
          <article class="talk-card">
            <h3 class="talk-title">{talk.title}</h3>
            {talk.description && <p class="talk-desc">{talk.description}</p>}
            <div class="talk-meta">{talk.event}{talk.location ? ` · ${talk.location}` : ''} · {talk.year}</div>

            {talk.youtubeId ? (
              <div class="talk-embed" data-yt={talk.youtubeId}>
                <button class="talk-embed-poster" type="button" aria-label={`Play ${talk.title}`}>
                  <img src={`https://img.youtube.com/vi/${talk.youtubeId}/hqdefault.jpg`} alt={talk.title} loading="lazy" />
                  <span class="talk-play-btn" aria-hidden="true">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><polygon points="8,5 20,12 8,19" fill="currentColor"/></svg>
                  </span>
                </button>
              </div>
            ) : (
              <div class="talk-embed talk-embed-empty">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><polygon points="9,7 19,12 9,17" fill="currentColor" opacity="0.25"/></svg>
              </div>
            )}
          </article>
        ))}
      </div>
      <a href="/talks" class="section-link" style="display:inline-block; margin-top:2.5rem;">all talks →</a>
    </section>


  </div>

  <footer class="home-footer">
    <div class="home-footer-inner">
      <p class="footer-copy">© {new Date().getFullYear()} Khoi Tran</p>
      <div class="footer-links">
        {[['https://github.com/khoitrn','GitHub'],['https://linkedin.com/in/khoitrn','LinkedIn'],['mailto:khoi@tamu.edu','Email']].map(([href,label]) => (
          <a href={href} target={href.startsWith('http')?'_blank':undefined} rel={href.startsWith('http')?'noopener noreferrer':undefined} class="footer-link">{label}</a>
        ))}
      </div>
    </div>
  </footer>

</Layout>

<style>
  /* ── Shoji panels ── */
  .shoji-panel {
    position: fixed;
    top: 0;
    height: 100vh;
    width: 50vw;
    overflow: hidden;
    will-change: transform;
    z-index: 30;
  }
  #panel-left  { left: 0; }
  #panel-right { right: 0; }

  .panel-img {
    position: absolute;
    top: 0;
    width: 100vw;
    height: 100vh;
    background-image: url('/hero.svg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    pointer-events: none;
  }
  .panel-img-left  { left: 0; }
  .panel-img-right { right: 0; }

  /* Center seam line */
  #panel-left::after {
    content: '';
    position: absolute;
    top: 0; right: 0;
    width: 1px;
    height: 100%;
    background: rgba(0,0,0,0.5);
    z-index: 2;
  }

  /* ── Hero overlay ── */
  #hero-overlay {
    position: fixed;
    inset: 0;
    z-index: 40;
    pointer-events: none;
    will-change: opacity;
  }

  /* Left nav — separate fixed element, hidden during shoji, fades in when open */
  .hero-left-nav {
    position: fixed;
    left: 2.5rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    z-index: 45;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1);
  }
  .hero-left-nav.nav-open {
    opacity: 1;
    pointer-events: auto;
  }
  .hero-nav-link {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    color: rgba(255,255,255,0.4);
    text-decoration: none;
    transition: color 0.4s;
  }

  /* Diamond button below nav */
  .hero-diamond-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    margin-top: 0.75rem;
    text-decoration: none;
    overflow: visible;
    position: relative;
  }
  .hero-diamond-btn::after {
    content: '';
    position: absolute;
    inset: -6px;
    background: conic-gradient(from 0deg, transparent 0%, rgba(196,144,58,0.2) 15%, transparent 30%);
    border-radius: 50%;
    animation: nav-star-spin 6s linear infinite;
    pointer-events: none;
  }
  @keyframes nav-star-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  .nav-star-svg { width: 22px; height: 22px; overflow: visible; display: block; }
  .nav-star-glow {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    opacity: 0;
    filter: blur(2.5px);
    animation: nav-star-pulse 3.5s ease-in-out infinite;
  }
  .nav-star-shape {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.2;
    stroke-linejoin: round;
    animation: nav-star-breathe 3.5s ease-in-out infinite;
  }
  .nav-star-inner {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 0.8;
    opacity: 0.4;
    animation: nav-star-breathe 3.5s ease-in-out infinite 0.4s;
  }
  @keyframes nav-star-breathe {
    0%, 100% { opacity: 0.35; }
    50%       { opacity: 1; }
  }
  @keyframes nav-star-pulse {
    0%, 100% { opacity: 0; }
    50%       { opacity: 0.6; }
  }
  .hero-diamond-btn:hover .nav-star-shape,
  .hero-diamond-btn:hover .nav-star-inner { opacity: 1; }

  /* Center text — truly centered */
  .hero-center-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 2rem;
    pointer-events: none;
  }
  .hero-tagline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.6rem;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.28);
    margin-bottom: 1.25rem;
  }
  .hero-name {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    line-height: 1;
    letter-spacing: -0.025em;
    color: rgba(255,255,255,0.95);
    margin-bottom: 1.25rem;
  }
  .hero-para {
    font-family: var(--font-body);
    font-size: clamp(0.8rem, 1.2vw, 0.9375rem);
    line-height: 1.75;
    color: rgba(255,255,255,0.32);
    max-width: 36ch;
  }

  /* Scroll hint */
  #hero-scroll-hint {
    position: absolute;
    bottom: 2rem;
    right: 2.5rem;
    pointer-events: none;
  }
  #hero-scroll-hint span {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.58rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.18);
  }

  /* Hamburger */
  .hero-hamburger {
    display: none;
    position: absolute;
    top: 1.5rem; right: 1.75rem;
    background: none;
    border: none;
    cursor: pointer;
    flex-direction: column;
    gap: 5px;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    z-index: 1;
    padding: 0.5rem;
  }
  .hero-hamburger span {
    display: block;
    width: 22px;
    height: 1px;
    background: rgba(255,255,255,0.5);
  }

  /* Mobile overlay menu */
  .hero-mobile-menu {
    display: none;
    position: fixed;
    inset: 0;
    background: var(--color-canvas);
    z-index: 300;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
  }
  .hero-mobile-menu.open { display: flex; }
  .hero-mobile-menu a {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 2rem;
    letter-spacing: 0.1em;
    color: var(--color-ink);
    text-decoration: none;
    transition: color 0.3s;
  }
  .hero-mobile-menu a:hover { color: var(--color-accent); }
  .hero-menu-close {
    position: absolute;
    top: 2rem; right: 1.75rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    transition: color 0.3s;
  }
  .hero-menu-close:hover { color: var(--color-ink); }

  /* Mobile: single panel + hide desktop nav */
  @media (max-width: 768px) {
    .hero-hamburger { display: flex; }
    .hero-left-nav  { display: none !important; }
    #panel-right    { display: none; }
    #panel-left     { width: 100vw; }
    #panel-left::after { display: none; }
    .hero-center-text {
      padding: 0 1.75rem;
      align-items: center;
    }
  }

  /* ── Content ── */
  .shoji-spacer { height: 160vh; }

  .home-body {
    max-width: 640px;
    padding-top: 0;
    padding-bottom: 8rem;
  }
  .home-section { padding: 4rem 0; }

  /* ── About ── */
  .about-text {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink-soft);
    line-height: 1.85;
    margin-bottom: 0.85rem;
  }
  .about-sub {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.85;
    margin-bottom: 2rem;
  }

  /* Status row */
  .status-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }
  .status-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
    transition: background 0.6s;
  }
  .status-dot.offline { background: var(--color-muted); opacity: 0.4; }
  .status-time, .status-loc {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .status-sep { color: var(--color-border); }

  .social-links {
    display: flex;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }
  .social-link {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.4s;
  }
  .social-link:hover { color: var(--color-ink); }

  .section-link {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.4s;
  }
  .section-link:hover { color: var(--color-ink); }

  .section-label {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-muted);
    opacity: 0.7;
  }

  /* ── Currently ── */
  .currently-text {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.85;
    margin: 1.25rem 0 1.75rem;
  }

  /* ── Work + Writing ── */
  .grid-work-writing {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }
  .col-rule { display: none; }
  .col-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .col-link {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.4s;
  }
  .col-link:hover { color: var(--color-ink); }
  .col-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
    text-decoration: none;
    transition: opacity 0.3s;
  }
  .col-row:hover { opacity: 0.6; }
  .col-row-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.9rem;
    color: var(--color-ink);
    line-height: 1.3;
    flex: 1;
    transition: transform 0.45s cubic-bezier(0.16,1,0.3,1);
  }
  .col-row:hover .col-row-title { transform: translateX(4px); }
  .col-row-meta {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    display: flex;
    gap: 1rem;
    opacity: 0.6;
    flex-shrink: 0;
  }
  .empty-note {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 2rem 0;
    opacity: 0.6;
  }

  /* ── Talks ── */
  .talk-row { padding: 2rem 0; }
  .talk-row-border { margin-top: 1rem; }
  .talk-inner {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.75rem;
    align-items: start;
  }
  .talk-thumb-wrap {
    width: 8rem;
    aspect-ratio: 16/9;
    border-radius: 2px;
    overflow: hidden;
    background: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .talk-thumb {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    opacity: 0.65;
    transition: opacity 0.4s, filter 0.4s;
  }
  .talk-row:hover .talk-thumb { opacity: 0.85; filter: grayscale(0.3); }
  .talk-thumb-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    color: var(--color-muted);
  }
  .talk-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(0.95rem, 1.8vw, 1.25rem);
    color: var(--color-ink);
    line-height: 1.3;
    margin-bottom: 0.5rem;
    transition: transform 0.45s cubic-bezier(0.16,1,0.3,1);
  }
  .talk-row:hover .talk-title { transform: translateX(4px); }
  .talk-desc {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.7;
  }
  .talk-meta {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 0.6rem;
    opacity: 0.6;
  }
  .talk-watch-link {
    color: var(--color-accent);
    text-decoration: none;
    opacity: 1;
