---
import Layout from '../layouts/Layout.astro';
import { client, nowQuery, portableTextToHtml, formatDate } from '../lib/sanity';

const now = await client.fetch(nowQuery);
const html = now ? portableTextToHtml(now.body ?? []) : null;
const updated = now?.updatedAt ? formatDate(now.updatedAt) : null;
---

<Layout title="Now" description="What Khoi is currently working on.">
  <div class="now-page page-pad">
    <div class="now-wrap">

      <div class="now-header">
        <p class="animate-fade-up" style="font-family:var(--font-display); font-weight:300; font-size:0.65rem; letter-spacing:0.3em; text-transform:uppercase; color:var(--color-muted); margin-bottom:1.25rem;">Now</p>
        <h1 class="animate-fade-up delay-1" style="font-family:var(--font-display); font-weight:300; font-size:clamp(2.25rem,5vw,3.5rem); line-height:1.1; letter-spacing:-0.02em; color:var(--color-ink);">
          What I'm doing now.
        </h1>
        {updated && (
          <p class="animate-fade-up delay-2" style="font-family:var(--font-display); font-weight:300; font-size:0.65rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--color-muted); margin-top:1.25rem;">
            Updated {updated}
          </p>
        )}
      </div>

      {html ? (
        <div class="reveal prose" set:html={html} />
      ) : (
        <div class="reveal prose">
          <p>Updated May 2025 from Texas.</p>
          <h2>Building</h2>
          <p>Working on a new project — still in early days, focused on getting the core right before anything else.</p>
          <h2>Studying</h2>
          <p>Finishing up the semester at Texas A&M. Juggling coursework with building, which is harder than it sounds and more valuable than it seems.</p>
          <h2>Thinking about</h2>
          <p>What makes a product actually good. The gap between clever and useful. How to build something worth building.</p>
          <hr />
          <p>This is a <a href="https://nownownow.com/about" target="_blank" rel="noopener">now page</a> — a snapshot of what I'm focused on at this point in time.</p>
        </div>
      )}

    </div>
  </div>
</Layout>

<style>
  .now-wrap {
    max-width: 720px;
    margin: 0 auto;
  }
  .now-header {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: 2rem;
    padding-bottom: 0.5rem;
  }
  @media (max-width: 640px) {
    :global(.prose) {
      font-size: 1.0625rem !important;
      line-height: 1.9 !important;
    }
  }
</style>
