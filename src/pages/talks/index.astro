---
import Layout from '../../layouts/Layout.astro';
import { client, talksQuery, urlFor } from '../../lib/sanity';

const talks = await client.fetch(talksQuery);

function youtubeId(url: string | null | undefined): string | null {
  if (!url) return null;
  const m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([A-Za-z0-9_-]{11})/);
  return m ? m[1] : null;
}
function thumbUrl(talk: any): string | null {
  if (talk.thumbnail) return urlFor(talk.thumbnail).width(800).auto('format').url();
  const id = youtubeId(talk.mediaUrl);
  return id ? `https://img.youtube.com/vi/${id}/mqdefault.jpg` : null;
}

const fallback = [
  {
    _id: '1', title: 'Building Products at the Edge of Uncertainty',
    event: 'Texas A&M Engineering Symposium', location: 'College Station, TX', year: '2024',
    description: 'On the process of making decisions when you don\'t have all the information — and why that\'s the only way to build anything worth building.',
    mediaUrl: null, thumbnail: null,
  },
  {
    _id: '2', title: 'From Zero to Launch: A Student Founder\'s Playbook',
    event: 'Startup Week Houston', location: 'Houston, TX', year: '2023',
    description: 'How to ship fast without cutting the things that matter, told through the mistakes I made building my first product.',
    mediaUrl: null, thumbnail: null,
  },
];

const items = talks.length > 0 ? talks : fallback;
---

<Layout title="Talks — Khoi Tran" description="Talks and presentations by Khoi Tran.">
  <div style="padding: 7rem max(calc((100vw - 640px) / 2), 2rem) 8rem;">
    <div>

      <!-- Page header -->
      <header class="animate-fade-up" style="margin-bottom: 6rem;">
        <p class="page-label">Talks</p>
        <p class="page-sub">Conversations I've been part of — on building, thinking, and starting things.</p>
      </header>

      <!-- Talk list — no dividers, spacing + year as separator -->
      <div class="talk-list">
        {items.map((talk: any, i: number) => {
          const thumb  = thumbUrl(talk);
          const ytId   = youtubeId(talk.mediaUrl);
          const href   = talk.mediaUrl ?? null;

          return (
            <article class="talk-item reveal" style={`transition-delay:${i * 100}ms`}>

              <!-- Index + year line -->
              <div class="talk-index-row">
                <span class="talk-num">0{i + 1}</span>
                <span class="talk-year">{talk.year}</span>
              </div>

              <!-- Title -->
              <h2 class="talk-title">
                {href ? (
                  <a href={href} target="_blank" rel="noopener noreferrer" class="talk-title-link">{talk.title}</a>
                ) : talk.title}
              </h2>

              <!-- Description -->
              {talk.description && <p class="talk-desc">{talk.description}</p>}

              <!-- Thumbnail — full width, below text -->
              {thumb && (
                <div class="talk-thumb">
                  {href ? (
                    <a href={href} target="_blank" rel="noopener noreferrer" class="thumb-wrap" aria-label={`Watch ${talk.title}`}>
                      <img src={thumb} alt={talk.title} loading="lazy" />
                      <span class="thumb-play" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                          <polygon points="8,5 20,12 8,19" fill="currentColor"/>
                        </svg>
                      </span>
                    </a>
                  ) : <img src={thumb} alt={talk.title} loading="lazy" />}
                </div>
              )}

              <!-- Event line + CTA -->
              <div class="talk-footer">
                <span class="talk-event">{talk.event}{talk.location ? ` · ${talk.location}` : ''}</span>
                {href && (
                  <a href={href} target="_blank" rel="noopener noreferrer" class="talk-cta">
                    {ytId ? 'watch on youtube' : 'view recording'} →
                  </a>
                )}
              </div>

            </article>
          );
        })}
      </div>

    </div>
  </div>
</Layout>

<style>
  /* Header */
  .page-label {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    line-height: 1;
    margin-bottom: 1.5rem;
  }
  .page-sub {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.8;
    max-width: 44ch;
  }

  /* Talk list — spacing is the only separator */
  .talk-list { display: flex; flex-direction: column; }

  .talk-item {
    padding-bottom: 6rem;
    border: none;
    outline: none;
  }
  .talk-item + .talk-item {
    padding-top: 5rem;
  }

  /* Index row: 01 ············ 2024 */
  .talk-index-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.75rem;
  }
  .talk-num {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    color: var(--color-muted);
    opacity: 0.45;
  }
  .talk-year {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    color: var(--color-muted);
    opacity: 0.45;
  }

  /* Title */
  .talk-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.5rem, 3.5vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-bottom: 1.25rem;
  }
  .talk-title-link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.3s;
  }
  .talk-title-link:hover { opacity: 0.7; }

  /* Description */
  .talk-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.85;
    margin-bottom: 2rem;
  }

  /* Thumbnail — full container width */
  .talk-thumb {
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 2px;
    overflow: hidden;
    background: var(--color-surface);
    margin-bottom: 1.5rem;
  }
  .thumb-wrap {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
  }
  .talk-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.5);
    opacity: 0.85;
    transition: filter 0.5s, opacity 0.5s;
    display: block;
  }
  .talk-item:hover .talk-thumb img { filter: grayscale(0); opacity: 1; }

  .thumb-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.25);
    opacity: 0;
    transition: opacity 0.3s;
    color: rgba(255,255,255,0.9);
  }
  .thumb-wrap:hover .thumb-play { opacity: 1; }

  /* Event + CTA row */
  .talk-footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .talk-event {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
    opacity: 0.6;
  }
  .talk-cta {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.4s;
  }
  .talk-cta:hover { color: var(--color-ink); }

  @media (max-width: 600px) {
    .talk-item { padding-bottom: 4rem; }
    .talk-item + .talk-item { padding-top: 4rem; }
    .talk-footer { flex-direction: column; gap: 0.75rem; }
  }
</style>
