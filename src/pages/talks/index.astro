---
import Layout from '../../layouts/Layout.astro';
import { client, talksQuery, urlFor } from '../../lib/sanity';

const talks = await client.fetch(talksQuery);

function youtubeId(url: string | null | undefined): string | null {
  if (!url) return null;
  const m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([A-Za-z0-9_-]{11})/);
  return m ? m[1] : null;
}
function thumbUrl(talk: any): string | null {
  if (talk.thumbnail) return urlFor(talk.thumbnail).width(800).auto('format').url();
  const id = youtubeId(talk.mediaUrl);
  return id ? `https://img.youtube.com/vi/${id}/mqdefault.jpg` : null;
}

const fallback = [
  {
    _id: '1', title: 'Building Products at the Edge of Uncertainty',
    event: 'Texas A&M Engineering Symposium', location: 'College Station, TX', date: '2024-01-01',
    description: 'On the process of making decisions when you don\'t have all the information — and why that\'s the only way to build anything worth building.',
    mediaUrl: null, thumbnail: null,
  },
  {
    _id: '2', title: 'From Zero to Launch: A Student Founder\'s Playbook',
    event: 'Startup Week Houston', location: 'Houston, TX', date: '2023-01-01',
    description: 'How to ship fast without cutting the things that matter, told through the mistakes I made building my first product.',
    mediaUrl: null, thumbnail: null,
  },
];

const items = talks.length > 0 ? talks : fallback;
const talkYear = (t: any) => (t.date ? new Date(t.date).getFullYear() : '');
---

<Layout title="Talks — Khoi Tran" description="Talks and presentations by Khoi Tran.">
  <div style="padding: 7rem max(calc((100vw - 640px) / 2), 2rem) 8rem;">
    <div>

      <!-- Page header -->
      <header class="animate-fade-up" style="margin-bottom: 6rem;">
        <p class="page-label">Talks</p>
        <p class="page-sub">Conversations I've been part of — on building, thinking, and starting things.</p>
      </header>

      <!-- Talk list — no dividers, spacing + year as separator -->
      <div class="talk-list">
        {items.map((talk: any, i: number) => {
          const thumb  = thumbUrl(talk);
          const ytId   = youtubeId(talk.mediaUrl);
          const href   = talk.mediaUrl ?? null;

          return (
            <article class="talk-item reveal" style={`transition-delay:${i * 100}ms`}>

              <!-- Index + year line -->
              <div class="talk-index-row">
                <span class="talk-num">0{i + 1}</span>
                <span class="talk-year">{talkYear(talk)}</span>
              </div>

              <!-- Title -->
              <h2 class="talk-title">
                {href ? (
                  <a href={href} target="_blank" rel="noopener noreferrer" class="talk-title-link">{talk.title}</a>
                ) : talk.title}
              </h2>

              <!-- Description -->
              {talk.description && <p class="talk-desc">{talk.description}</p>}

              <!-- Inline embed — click poster to play on-site -->
              {ytId ? (
                <div class="talk-embed" data-yt={ytId}>
                  <button class="talk-embed-poster" type="button" aria-label={`Play ${talk.title}`}>
                    <img src={`https://img.youtube.com/vi/${ytId}/hqdefault.jpg`} alt={talk.title} loading="lazy" />
                    <span class="talk-play-btn" aria-hidden="true">
                      <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><polygon points="8,5 20,12 8,19" fill="currentColor"/></svg>
                    </span>
                  </button>
                </div>
              ) : thumb ? (
                <div class="talk-embed"><img src={thumb} alt={talk.title} loading="lazy" style="width:100%;height:100%;object-fit:cover;" /></div>
              ) : null}

              <!-- Event line -->
              <div class="talk-footer">
                <span class="talk-event">{talk.event}{talk.location ? ` · ${talk.location}` : ''}</span>
                {href && !ytId && (
                  <a href={href} target="_blank" rel="noopener noreferrer" class="talk-cta">view recording →</a>
                )}
              </div>

            </article>
          );
        })}
      </div>

    </div>
  </div>
</Layout>

<style>
  /* Header */
  .page-label {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    line-height: 1;
    margin-bottom: 1.5rem;
  }
  .page-sub {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.8;
    max-width: 44ch;
  }

  /* Talk list — spacing is the only separator */
  .talk-list { display: flex; flex-direction: column; }

  .talk-item {
    padding-bottom: 6rem;
    border: none;
    outline: none;
  }
  .talk-item + .talk-item {
    padding-top: 5rem;
  }

  /* Index row: 01 ············ 2024 */
  .talk-index-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.75rem;
  }
  .talk-num {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    color: var(--color-muted);
    opacity: 0.45;
  }
  .talk-year {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    color: var(--color-muted);
    opacity: 0.45;
  }

  /* Title */
  .talk-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.5rem, 3.5vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-bottom: 1.25rem;
  }
  .talk-title-link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.3s;
  }
  .talk-title-link:hover { opacity: 0.7; }

  /* Description */
  .talk-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.85;
    margin-bottom: 2rem;
  }

  /* Inline embed — full container width */
  .talk-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 3px;
    overflow: hidden;
    background: #000;
    margin-bottom: 1.5rem;
  }
  .talk-embed-poster {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    padding: 0; border: none; cursor: pointer;
    background: #000; display: block;
  }
  .talk-embed-poster img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(0.4);
    opacity: 0.82;
    transition: filter 0.5s, opacity 0.5s, transform 0.6s cubic-bezier(0.16,1,0.3,1);
    display: block;
  }
  .talk-embed-poster:hover img { filter: grayscale(0); opacity: 1; transform: scale(1.02); }
  .talk-play-btn {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    color: #fff;
  }
  .talk-play-btn svg {
    width: 54px; height: 54px;
    padding: 14px;
    border-radius: 50%;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(2px);
    transition: background 0.3s, transform 0.3s, color 0.3s;
  }
  .talk-embed-poster:hover .talk-play-btn svg { background: var(--color-accent); color: #000; transform: scale(1.05); }
  .talk-embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  /* Event + CTA row */
  .talk-footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .talk-event {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
    opacity: 0.6;
  }
  .talk-cta {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.4s;
  }
  .talk-cta:hover { color: var(--color-ink); }

  @media (max-width: 600px) {
    .talk-item { padding-bottom: 4rem; }
    .talk-item + .talk-item { padding-top: 4rem; }
    .talk-footer { flex-direction: column; gap: 0.75rem; }
  }
</style>

<script>
  // Click poster → inline YouTube embed (plays on-site)
  document.querySelectorAll<HTMLElement>('.talk-embed[data-yt]').forEach(wrap => {
    const btn = wrap.querySelector('.talk-embed-poster');
    btn?.addEventListener('click', () => {
      const id = wrap.dataset.yt;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.title = 'Talk video';
      wrap.innerHTML = '';
      wrap.appendChild(iframe);
    });
  });
</script>
