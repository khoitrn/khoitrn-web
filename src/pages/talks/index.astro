---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Glyph from '../../components/ui/Glyph.astro';
import { client, talksQuery, urlFor } from '../../lib/sanity';

const talks = await client.fetch(talksQuery);

function youtubeId(url: string | null | undefined): string | null {
  if (!url) return null;
  const m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([A-Za-z0-9_-]{11})/);
  return m ? m[1] : null;
}
function thumbUrl(talk: any): string | null {
  if (talk.thumbnail) return urlFor(talk.thumbnail).width(800).auto('format').url();
  const id = youtubeId(talk.mediaUrl);
  return id ? `https://img.youtube.com/vi/${id}/mqdefault.jpg` : null;
}

const fallback = [
  {
    _id: '1', title: 'Building Products at the Edge of Uncertainty',
    event: 'Texas A&M Engineering Symposium', location: 'College Station, TX', date: '2024-01-01',
    description: 'On the process of making decisions when you don\'t have all the information — and why that\'s the only way to build anything worth building.',
    mediaUrl: null, thumbnail: null,
  },
  {
    _id: '2', title: 'From Zero to Launch: A Student Founder\'s Playbook',
    event: 'Startup Week Houston', location: 'Houston, TX', date: '2023-01-01',
    description: 'How to ship fast without cutting the things that matter, told through the mistakes I made building my first product.',
    mediaUrl: null, thumbnail: null,
  },
];

const items = talks.length > 0 ? talks : fallback;
const talkWhen = (t: any) => (t.date ? new Date(t.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : '');
---

<Layout title="Talks — Khoi Tran" description="Talks and presentations by Khoi Tran.">
  <div class="open-wrap">
    <PageHead title="talks" sub="things i've said out loud, on a stage." />

    <div class="talk-list">
      {items.map((talk: any, i: number) => {
        const thumb = thumbUrl(talk);
        const ytId  = youtubeId(talk.mediaUrl);
        const href  = `/talks/${talk.slug?.current ?? talk._id}`;
        const where = [talk.event, talk.location, talkWhen(talk)].filter(Boolean).join(', ');
        return (
          <article class="talk-item reveal" style={`transition-delay:${i * 100}ms`}>
            <div class="talk-media">
              {ytId ? (
                <div class="talk-embed" data-yt={ytId}>
                  <button class="talk-embed-poster" type="button" aria-label={`Play ${talk.title}`}>
                    <img src={`https://img.youtube.com/vi/${ytId}/hqdefault.jpg`} alt="" loading="lazy" />
                    <span class="talk-play" aria-hidden="true">
                      <svg width="36" height="36" viewBox="0 0 36 36"><circle cx="18" cy="18" r="17" fill="none" stroke="currentColor"/><path d="M15 12 L25 18 L15 24 Z" fill="currentColor"/></svg>
                      <span>watch the talk</span>
                    </span>
                  </button>
                </div>
              ) : thumb ? (
                <div class="talk-embed"><img src={thumb} alt="" loading="lazy" /></div>
              ) : (
                <div class="talk-glyph"><Glyph kind="trail" seed={talk.slug?.current ?? talk._id} width={340} accent /></div>
              )}
            </div>

            <div class="talk-body">
              {where && <p class="open-label">{where}</p>}
              <h2><a href={href}>{talk.title}</a></h2>
              {talk.description && <p class="talk-desc">{talk.description}</p>}
              <div class="talk-links">
                <a href={href}>read the write-up →</a>
                {ytId && <a href={`https://www.youtube.com/watch?v=${ytId}`} target="_blank" rel="noopener noreferrer">watch on youtube →</a>}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</Layout>

<style>
  .talk-list { margin-top: 4.5rem; display: flex; flex-direction: column; gap: 6rem; }
  .talk-item { display: grid; grid-template-columns: 1.2fr 1fr; gap: 4.5rem; align-items: center; }

  .talk-media { position: relative; min-height: 20rem; display: flex; align-items: center; }
  .talk-glyph {
    width: 100%; min-height: 25rem; display: flex; align-items: center; justify-content: center;
    background: radial-gradient(65% 75% at 50% 50%, rgba(196, 144, 58, 0.2), rgba(13, 13, 10, 0) 70%);
  }
  .talk-embed { position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 2px; background: var(--color-surface); }
  .talk-embed img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.85; transition: opacity 0.4s; }
  .talk-embed-poster { position: absolute; inset: 0; width: 100%; height: 100%; background: none; border: 0; padding: 0; cursor: pointer; color: var(--color-ink); }
  .talk-embed-poster:hover img { opacity: 1; }
  .talk-embed-poster::after { content: ''; position: absolute; inset: auto 0 0 0; height: 45%; background: linear-gradient(transparent, rgba(13, 13, 10, 0.85)); pointer-events: none; }
  .talk-play { z-index: 1; position: absolute; left: 1.25rem; bottom: 1.1rem; display: flex; align-items: center; gap: 0.75rem; font-family: var(--font-display); font-weight: 300; font-size: 0.875rem; color: var(--color-ink); }
  .talk-play svg { color: var(--color-accent); }

  .talk-body { border-top: 1px solid rgba(196, 144, 58, 0.5); padding-top: 1.75rem; }
  .talk-body h2 { margin: 0.85rem 0 1.25rem; font-family: var(--font-display); font-weight: 300; font-size: clamp(1.9rem, 3.2vw, 2.6rem); line-height: 1.15; }
  .talk-body h2 a { color: var(--color-accent); text-decoration: none; }
  .talk-desc { font-family: var(--font-body); font-size: 1.125rem; line-height: 1.75; color: var(--color-ink-soft); margin-bottom: 1.75rem; }
  .talk-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; }
  .talk-links a { font-family: var(--font-display); font-weight: 300; font-size: 0.875rem; letter-spacing: 0.04em; color: var(--color-accent); text-decoration: none; padding: 0.4rem 0; }
  .talk-links a:hover { color: var(--color-ink); }

  @media (max-width: 860px) {
    .talk-item { grid-template-columns: 1fr; gap: 2rem; }
    .talk-media, .talk-glyph { min-height: 0; }
    .talk-glyph { min-height: 14rem; }
    .talk-list { gap: 4.5rem; margin-top: 3rem; }
  }
</style>

<script>
  // Click poster → inline YouTube embed (plays on-site)
  document.querySelectorAll<HTMLElement>('.talk-embed[data-yt]').forEach(wrap => {
    const btn = wrap.querySelector('.talk-embed-poster');
    btn?.addEventListener('click', () => {
      const id = wrap.dataset.yt;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.title = 'Talk video';
      // Inline styles — scoped CSS doesn't apply to JS-created elements
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;display:block;';
      wrap.innerHTML = '';
      wrap.appendChild(iframe);
    });
  });
</script>
