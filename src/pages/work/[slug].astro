---
import Layout from '../../layouts/Layout.astro';
import { client, projectsQuery, projectBySlugQuery, portableTextToHtml, urlFor } from '../../lib/sanity';

export async function getStaticPaths() {
  const projects = await client.fetch(projectsQuery);
  return projects.map((p: any) => ({ params: { slug: p.slug.current } }));
}

const { slug } = Astro.params;
const project = await client.fetch(projectBySlugQuery, { slug });
if (!project) return Astro.redirect('/work');

const html = portableTextToHtml(project.body ?? []);
const coverUrl = project.coverImage ? urlFor(project.coverImage).width(1600).auto('format').url() : null;
---

<Layout title={project.title} description={project.description}>
  <div class="page-pad">

    <!-- Header -->
    <header class="proj-header">
      <a href="/work" class="back-link">work</a>

      <div class="animate-fade-up proj-meta">
        {project.category && <span class="meta-item">{project.category}</span>}
        {project.year && <><span class="meta-dot">·</span><span class="meta-item">{project.year}</span></>}
      </div>

      <h1 class="animate-fade-up delay-1 proj-headline">{project.title}</h1>
      {project.description && <p class="animate-fade-up delay-2 proj-lede">{project.description}</p>}

      <div class="animate-fade-up delay-3 proj-tech">
        {project.technologies?.map((tech: string) => (
          <span class="tech-tag">{tech}</span>
        ))}
        {project.url && (
          <a href={project.url} target="_blank" rel="noopener noreferrer" class="proj-url">
            Visit project →
          </a>
        )}
      </div>
    </header>

    <!-- Cover image -->
    {coverUrl && (
      <div class="reveal proj-cover">
        <div style="aspect-ratio:16/9; overflow:hidden; background:var(--color-surface);">
          <img src={coverUrl} alt={project.title} style="width:100%; height:100%; object-fit:cover;" loading="lazy" />
        </div>
      </div>
    )}

    <!-- Body -->
    {html && (
      <div class="proj-body-wrap">
        <div class="reveal prose" set:html={html} />
      </div>
    )}

    <!-- Back links -->
    <nav class="proj-footer">
      <a href="/work" class="back-link">work</a>
    </nav>

  </div>
</Layout>

<style>
  .proj-header {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 5vw, 3rem) 4.5rem;
  }
  .proj-cover {
    max-width: 1100px;
    margin: 4rem auto 0;
    padding: 0 clamp(1rem, 5vw, 3rem);
  }
  .proj-body-wrap {
    max-width: 720px;
    margin: 4rem auto 0;
    padding: 0 clamp(1rem, 5vw, 3rem);
  }
  .proj-footer {
    max-width: 1100px;
    margin: 6rem auto 0;
    padding: 0 clamp(1rem, 5vw, 3rem);
    display: flex;
    gap: 2.5rem;
  }

  .back-link {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 3rem;
    transition: color 0.4s;
  }
  .back-link:hover { color: var(--color-ink); }
  .proj-footer .back-link { margin-bottom: 0; }

  .proj-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }
  .meta-item {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .meta-dot { color: var(--color-border); }

  .proj-headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.9rem, 5vw, 3.75rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .proj-lede {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2.5vw, 1.1rem);
    color: var(--color-muted);
    line-height: 1.75;
    margin-top: 1.5rem;
    max-width: 56ch;
  }

  .proj-tech {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .tech-tag {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.75rem;
  }
  .proj-url {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
    margin-left: auto;
    transition: color 0.4s;
  }
  .proj-url:hover { color: var(--color-ink); }

  @media (max-width: 640px) {
    .proj-header { padding-bottom: 2.5rem; }
    .proj-body-wrap { margin-top: 2.5rem; }
    .proj-footer { margin-top: 3rem; }
    .proj-url { margin-left: 0; margin-top: 0.5rem; }

    :global(.prose) {
      font-size: 1.0625rem !important;
      line-height: 1.9 !important;
    }
    :global(.prose pre) {
      padding: 1.25rem !important;
      font-size: 0.8rem !important;
    }
  }
</style>
