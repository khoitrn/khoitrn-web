---
import Layout from '../../layouts/Layout.astro';
import { client, projectsQuery, urlFor } from '../../lib/sanity';

const projects = await client.fetch(projectsQuery);
---

<Layout title="Work">
  <div class="page-pad" style="min-height:100svh;">
    <div style="max-width:1100px; margin:0 auto;">

      <!-- Header -->
      <div style="margin-bottom:clamp(3rem,6vw,6rem);">
        <p class="animate-fade-up" style="font-family:var(--font-display); font-weight:300; font-size:0.65rem; letter-spacing:0.35em; text-transform:uppercase; color:var(--color-muted); margin-bottom:1.25rem;">Work</p>
        <h1 class="animate-fade-up delay-1" style="font-family:var(--font-display); font-weight:300; font-size:clamp(2.25rem,6vw,5rem); line-height:1.05; letter-spacing:-0.025em; color:var(--color-ink);">Selected projects.</h1>
      </div>

      <!-- Project list — horizontal rows, cover preview, click through to the case study -->
      {projects.length > 0 ? (
        <div class="project-list">
          {projects.map((project: any, i: number) => {
            const coverUrl = project.coverImage ? urlFor(project.coverImage).width(900).auto('format').url() : null;
            return (
              <a href={`/work/${project.slug.current}`} class="reveal project-row" style={`transition-delay:${i*60}ms;`}>
                <div class="project-row-thumb">
                  {coverUrl && <img src={coverUrl} alt={project.title} loading="lazy" />}
                </div>
                <div class="project-row-body">
                  <div class="project-meta-row">
                    {project.category && <span class="proj-cat">{project.category}</span>}
                    {project.year && <span class="proj-year">{project.year}</span>}
                  </div>
                  <h2 class="project-title">{project.title}</h2>
                  {project.description && <p class="proj-desc">{project.description}</p>}
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <p style="font-family:var(--font-display); font-weight:300; font-size:0.68rem; letter-spacing:0.25em; text-transform:uppercase; color:var(--color-muted); padding:4rem 0;">Projects coming soon.</p>
      )}

    </div>
  </div>
</Layout>

<style>
  .project-list {
    display: flex;
    flex-direction: column;
  }

  .project-row {
    display: grid;
    grid-template-columns: 22rem 1fr;
    gap: 3.5rem;
    align-items: center;
    padding: 5rem 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
  }
  .project-row:first-child { padding-top: 0; }
  .project-row:last-child { border-bottom: none; padding-bottom: 0; }

  .project-row-thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface);
  }
  .project-row-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    opacity: 0.8;
    transition: filter 0.5s, opacity 0.5s, transform 0.6s cubic-bezier(0.16,1,0.3,1);
    display: block;
  }
  .project-row:hover .project-row-thumb img {
    filter: grayscale(0);
    opacity: 1;
    transform: scale(1.03);
  }

  .project-meta-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
  }
  .proj-cat, .proj-year {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .proj-year::before { content: '·'; margin-right: 0.6rem; }

  .project-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    color: var(--color-ink);
    line-height: 1.25;
    margin-bottom: 0.85rem;
    transition: transform 0.45s cubic-bezier(0.16,1,0.3,1);
  }
  .project-row:hover .project-title { transform: translateX(6px); }

  .proj-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.75;
    max-width: 52ch;
  }

  @media (max-width: 780px) {
    .project-row {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 3rem 0;
    }
  }
</style>
