---
import Layout from '../../layouts/Layout.astro';
import { client, projectsQuery, urlFor } from '../../lib/sanity';

const projects = await client.fetch(projectsQuery);
---

<Layout title="Work">
  <div class="page-pad" style="min-height:100svh;">
    <div style="max-width:1100px; margin:0 auto;">

      <!-- Header -->
      <div style="margin-bottom:clamp(3rem,6vw,6rem);">
        <p class="animate-fade-up" style="font-family:var(--font-display); font-weight:300; font-size:0.65rem; letter-spacing:0.35em; text-transform:uppercase; color:var(--color-muted); margin-bottom:1.25rem;">Work</p>
        <h1 class="animate-fade-up delay-1" style="font-family:var(--font-display); font-weight:300; font-size:clamp(2.25rem,6vw,5rem); line-height:1.05; letter-spacing:-0.025em; color:var(--color-ink);">Selected projects.</h1>
      </div>

      <!-- Project grid — cover preview, click through to the case study -->
      {projects.length > 0 ? (
        <div class="project-grid">
          {projects.map((project: any, i: number) => {
            const coverUrl = project.coverImage ? urlFor(project.coverImage).width(900).auto('format').url() : null;
            return (
              <a href={`/work/${project.slug.current}`} class="reveal project-card" style={`transition-delay:${i*60}ms;`}>
                <div class="project-thumb">
                  {coverUrl && <img src={coverUrl} alt={project.title} loading="lazy" />}
                </div>
                <div class="project-meta-row">
                  {project.category && <span class="proj-cat">{project.category}</span>}
                  {project.year && <span class="proj-year">{project.year}</span>}
                </div>
                <h2 class="project-title">{project.title}</h2>
                {project.description && <p class="proj-desc">{project.description}</p>}
              </a>
            );
          })}
        </div>
      ) : (
        <p style="font-family:var(--font-display); font-weight:300; font-size:0.68rem; letter-spacing:0.25em; text-transform:uppercase; color:var(--color-muted); padding:4rem 0;">Projects coming soon.</p>
      )}

    </div>
  </div>
</Layout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4rem 2.5rem;
  }

  .project-card {
    display: block;
    text-decoration: none;
  }

  .project-thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface);
    margin-bottom: 1.25rem;
  }
  .project-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    opacity: 0.8;
    transition: filter 0.5s, opacity 0.5s, transform 0.6s cubic-bezier(0.16,1,0.3,1);
    display: block;
  }
  .project-card:hover .project-thumb img {
    filter: grayscale(0);
    opacity: 1;
    transform: scale(1.03);
  }

  .project-meta-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }
  .proj-cat, .proj-year {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .proj-year::before { content: '·'; margin-right: 0.6rem; }

  .project-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    color: var(--color-ink);
    line-height: 1.3;
    margin-bottom: 0.5rem;
    transition: transform 0.45s cubic-bezier(0.16,1,0.3,1);
  }
  .project-card:hover .project-title { transform: translateX(4px); }

  .proj-desc {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 42ch;
  }

  @media (max-width: 720px) {
    .project-grid { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>
