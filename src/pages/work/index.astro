---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Glyph from '../../components/ui/Glyph.astro';
import { client, projectsQuery, asCategoryArray } from '../../lib/sanity';

const projects = await client.fetch(projectsQuery);
const kinds = ['torii', 'sphere', 'hex'] as const;
---

<Layout title="Work">
  <div class="open-wrap">
    <PageHead title="work" sub="each project is a small cloud of points." />

    {projects.length > 0 ? (
      <div class="work-grid">
        {projects.map((project: any, i: number) => {
          const meta = [project.year, ...asCategoryArray(project.category)].filter(Boolean).join(', ');
          return (
            <a href={`/work/${project.slug.current}`} class="work-item glyph-host reveal" style={`transition-delay:${i * 80}ms;`}>
              <div class="work-glyph"><Glyph kind={kinds[i % kinds.length]} width={240} /></div>
              <div class="work-body">
                <div class="work-top">
                  <h2>{project.title}</h2>
                  <span class="open-label">{meta}{project.active === false ? ', paused' : ''}</span>
                </div>
                {project.description && <p>{project.description}</p>}
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <p class="open-label" style="padding:4rem 0;">projects coming soon.</p>
    )}
  </div>
</Layout>

<style>
  .work-grid { margin-top: 4.5rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4rem; }
  .work-item { display: block; text-decoration: none; }
  .work-glyph {
    height: 16rem; display: flex; align-items: center;
    background: radial-gradient(60% 70% at 30% 55%, rgba(196, 144, 58, 0), rgba(13, 13, 10, 0) 70%);
    transition: background 0.5s;
  }
  .work-item:hover .work-glyph, .work-item:focus-visible .work-glyph {
    background: radial-gradient(60% 70% at 30% 55%, rgba(196, 144, 58, 0.18), rgba(13, 13, 10, 0) 70%);
  }
  .work-body { margin-top: 0.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); transition: border-color 0.4s; }
  .work-item:hover .work-body, .work-item:focus-visible .work-body { border-color: rgba(196, 144, 58, 0.5); }
  .work-top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 0.75rem; }
  h2 { font-family: var(--font-display); font-weight: 300; font-size: 2.25rem; line-height: 1.1; color: var(--color-ink); transition: color 0.4s; }
  .work-item:hover h2, .work-item:focus-visible h2 { color: var(--color-accent); }
  .work-body p { font-family: var(--font-body); font-size: 1.0625rem; line-height: 1.7; color: var(--color-ink-soft); }
  @media (max-width: 960px) { .work-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem; } }
  @media (max-width: 620px) { .work-grid { grid-template-columns: 1fr; margin-top: 3rem; } .work-glyph { height: 11rem; } }
</style>
