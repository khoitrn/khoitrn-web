---
import Layout from '../../layouts/Layout.astro';
import { client, postsQuery, postBySlugQuery, portableTextToHtml, formatDate } from '../../lib/sanity';

export async function getStaticPaths() {
  const posts = await client.fetch(postsQuery);
  return posts.map((post: any) => ({ params: { slug: post.slug.current } }));
}

const { slug } = Astro.params;
const post = await client.fetch(postBySlugQuery, { slug });
if (!post) return Astro.redirect('/writing');

const html = portableTextToHtml(post.body ?? []);
---

<Layout title={post.title} description={post.excerpt}>
  <div class="page-pad">

    <!-- Header -->
    <header class="post-header">
      <a href="/writing" class="back-link">writing</a>

      <div class="animate-fade-up post-meta">
        <span class="meta-item">{post.category}</span>
        <span class="meta-dot">·</span>
        <span class="meta-item">{formatDate(post.publishedAt)}</span>
        {post.estimatedReadingTime && <>
          <span class="meta-dot">·</span>
          <span class="meta-item">{post.estimatedReadingTime} min read</span>
        </>}
      </div>

      <h1 class="animate-fade-up delay-1 post-headline">{post.title}</h1>
      {post.excerpt && <p class="animate-fade-up delay-2 post-lede">{post.excerpt}</p>}

      {post.tags?.length > 0 && (
        <div class="animate-fade-up delay-3 post-tags">
          {post.tags.map((tag: string) => <span class="post-tag">{tag}</span>)}
        </div>
      )}
    </header>

    <!-- Body -->
    <div class="post-body-wrap">
      <div class="reveal prose" set:html={html} />
    </div>

    <!-- Footer nav -->
    <nav class="post-footer">
      <a href="/writing" class="back-link">writing</a>
      <a href="/" class="back-link">khoitrn</a>
    </nav>

  </div>
</Layout>

<style>
  /* ── Layout ── */
  .post-header {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 5vw, 3rem) 4rem;
    border-bottom: 1px solid var(--color-border);
  }
  .post-body-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem clamp(1rem, 5vw, 3rem) 0;
  }
  .post-footer {
    max-width: 720px;
    margin: 5rem auto 0;
    padding: 2.5rem clamp(1rem, 5vw, 3rem) 0;
    border-top: 1px solid var(--color-border);
    display: flex;
    gap: 2.5rem;
  }

  /* ── Back link ── */
  .back-link {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 3rem;
    transition: color 0.4s;
  }
  .back-link:hover { color: var(--color-ink); }
  .post-footer .back-link { margin-bottom: 0; }

  /* ── Meta row ── */
  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }
  .meta-item {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .meta-dot { color: var(--color-border); }

  /* ── Headline & lede ── */
  .post-headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.9rem, 5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .post-lede {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2.5vw, 1.1rem);
    color: var(--color-muted);
    line-height: 1.75;
    margin-top: 1.5rem;
    max-width: 58ch;
  }

  /* ── Tags ── */
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .post-tag {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
    opacity: 0.65;
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.65rem;
    border-radius: 2rem;
  }

  /* ── Mobile reading (Kindle-feel) ── */
  @media (max-width: 640px) {
    .post-header { padding-bottom: 2.5rem; }
    .post-body-wrap { padding-top: 2.5rem; }
    .post-footer { margin-top: 3rem; }

    /* Slightly larger body text for thumb-scrolling comfort */
    :global(.prose) {
      font-size: 1.0625rem !important;
      line-height: 1.9 !important;
    }
    /* Tighten heading scale on mobile */
    :global(.prose h1) { font-size: 1.6rem !important; }
    :global(.prose h2) { font-size: 1.3rem !important; }
    :global(.prose h3) { font-size: 1.1rem !important; }

    /* More breathing room between paragraphs */
    :global(.prose p) { margin-bottom: 1.8em !important; }

    /* Code blocks don't overflow on mobile */
    :global(.prose pre) {
      padding: 1.25rem !important;
      font-size: 0.8rem !important;
    }
  }
</style>
