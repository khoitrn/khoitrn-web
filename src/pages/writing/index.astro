---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Glyph from '../../components/ui/Glyph.astro';
import { client, postsQuery, asCategoryArray } from '../../lib/sanity';

const posts = await client.fetch(postsQuery);
const hasVietnamese = posts.some((p: any) => p.language === 'vi');
const rawCategories = Array.from(new Set(posts.flatMap((p: any) => asCategoryArray(p.category)))) as string[];
rawCategories.sort((a, b) => (a === 'AI' ? -1 : b === 'AI' ? 1 : 0));
const categories = ['All', ...rawCategories];
const fmtDate = (d: string) => new Date(d).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<Layout title="Writing">
  <div class="open-wrap">
    <PageHead title="writing" sub="essays and notes, thinking out loud." />

    <div class="filters">
      {hasVietnamese && (
        <div id="lang-filter" role="group" aria-label="Language">
          <button data-lang="all" class="lang-btn active">all</button>
          <button data-lang="en" class="lang-btn">en</button>
          <button data-lang="vi" class="lang-btn">vi</button>
        </div>
      )}
      {categories.length > 1 && (
        <div id="filter-bar" role="group" aria-label="Category">
          {categories.map((cat: string) => (
            <button data-filter={cat} class="filter-btn">{cat}</button>
          ))}
        </div>
      )}
      <a href="/rss.xml" class="rss">rss</a>
    </div>

    {posts.length > 0 ? (
      <div id="post-list">
        {posts.map((post: any, i: number) => (
          <a
            href={`/writing/${post.slug.current}`}
            class="post-item glyph-host reveal"
            data-category={asCategoryArray(post.category).join('|')}
            data-language={post.language ?? 'en'}
            style={`transition-delay:${i * 50}ms;`}
          >
            <span class="open-label post-date">{post.publishedAt ? fmtDate(post.publishedAt) : ''}</span>
            <h2 class="post-title">{post.title}</h2>
            <span class="open-label post-category">
              {asCategoryArray(post.category).join(', ')}{post.language === 'vi' ? ', vi' : ''}
            </span>
            <span class="post-glyph"><Glyph kind="trail" seed={post.slug.current} width={100} /></span>
          </a>
        ))}
      </div>
    ) : (
      <p class="open-label" style="padding:4rem 0;">writing coming soon.</p>
    )}

    <!-- ◆ Philosophy: quiet corner, easy to miss -->
    <div class="philosophy-corner">
      <button class="philosophy-trigger" id="philosophy-trigger" aria-label="A note" title="">◆</button>
      <div class="philosophy-body" id="philosophy-body" aria-hidden="true">
        <p>I write to think. Not to record — to discover.</p>
        <p>Most of what I publish is unfinished. I don't know the answer when I start. That's why I start.</p>
        <p>I write because uncertainty makes me want to say something, and because saying it slowly turns it into something I can hold.</p>
        <p>If something here lands with you, that's enough.</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .filters { margin-top: 3rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 2rem; }
  #lang-filter, #filter-bar { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; }
  #lang-filter { padding-right: 2rem; border-right: 1px solid var(--color-border); }
  .lang-btn, .filter-btn {
    font-family: var(--font-display); font-weight: 300; font-size: 0.9375rem; letter-spacing: 0.04em; text-transform: lowercase;
    color: var(--color-muted); background: none; border: 0; border-bottom: 1px solid transparent; padding: 0.4rem 0 0.4rem; cursor: pointer;
    transition: color 0.25s, border-color 0.25s;
  }
  .lang-btn:hover, .filter-btn:hover { color: var(--color-ink); }
  .lang-btn.active, .filter-btn.active { color: var(--color-accent); border-bottom-color: var(--color-accent); }
  .rss { margin-left: auto; font-family: var(--font-display); font-weight: 300; font-size: 0.8125rem; letter-spacing: 0.06em; color: var(--color-muted); text-decoration: none; }
  .rss:hover { color: var(--color-accent); }

  /* a single hairline above the list; rows are separated by space alone */
  #post-list { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--color-border); }
  .post-item {
    display: grid; grid-template-columns: 7rem 1fr 13rem 6.5rem; align-items: center; gap: 1.5rem;
    padding: 1.6rem 0; text-decoration: none;
  }
  .post-title { font-family: var(--font-display); font-weight: 300; font-size: 2rem; line-height: 1.2; color: var(--color-ink); transition: color 0.35s; }
  .post-item:hover .post-title, .post-item:focus-visible .post-title { color: var(--color-accent); }
  .post-category { color: var(--color-muted); }
  .post-glyph { justify-self: end; }

  @media (max-width: 760px) {
    .post-item { grid-template-columns: 1fr; gap: 0.35rem; padding: 1.4rem 0; }
    .post-title { font-size: 1.5rem; }
    .post-date { order: -1; }
    .post-glyph { display: none; }
    .rss { margin-left: 0; }
    #lang-filter { border-right: 0; padding-right: 0; }
  }

  /* ── Philosophy corner ── */
  .philosophy-corner { margin-top: 6rem; }
  .philosophy-trigger { background: none; border: 0; cursor: pointer; color: var(--color-muted); opacity: 0.35; font-size: 0.8rem; padding: 0.75rem; transition: opacity 0.3s; }
  .philosophy-trigger:hover { opacity: 0.8; }
  .philosophy-body { max-height: 0; overflow: hidden; opacity: 0; transition: max-height 0.6s, opacity 0.6s; max-width: 34rem; text-transform: none; }
  .philosophy-body.visible { max-height: 40rem; opacity: 1; }
  .philosophy-body p { font-family: var(--font-body); font-style: italic; font-size: 1rem; line-height: 1.8; color: var(--color-muted); margin-top: 0.9rem; }
</style>

<script>
  const langBtns = document.querySelectorAll<HTMLButtonElement>('.lang-btn');
  const catBtns  = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items    = document.querySelectorAll<HTMLElement>('.post-item');

  let activeLang = 'all';
  let activeCat  = 'All';

  function applyFilters() {
    items.forEach(item => {
      const langOk = activeLang === 'all' || item.dataset.language === activeLang;
      const catOk  = activeCat  === 'All' || (item.dataset.category ?? '').split('|').includes(activeCat);
      item.style.display = langOk && catOk ? '' : 'none'; /* grid items: '' restores the grid display */
    });

  }

  // Language toggle
  langBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeLang = btn.dataset.lang!;
      langBtns.forEach(b => b.classList.toggle('active', b === btn));
      applyFilters();
    });
  });

  // Category filter
  const firstCat = document.querySelector<HTMLButtonElement>('.filter-btn[data-filter="All"]');
  if (firstCat) firstCat.classList.add('active');
  catBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeCat = btn.dataset.filter!;
      catBtns.forEach(b => b.classList.toggle('active', b === btn));
      applyFilters();
    });
  });

  // ◆ Philosophy toggle
  const trigger = document.getElementById('philosophy-trigger');
  const body    = document.getElementById('philosophy-body');
  trigger?.addEventListener('click', () => {
    const open = body?.classList.toggle('visible');
    body?.setAttribute('aria-hidden', open ? 'false' : 'true');
    if (trigger) trigger.style.opacity = open ? '0.55' : '';
  });

  // also toggle with 'p' key when not focused on input
  document.addEventListener('keydown', (e) => {
    if (e.key === 'p' && !['INPUT','TEXTAREA'].includes((e.target as HTMLElement).tagName)) {
      trigger?.click();
    }
  });
</script>
